#!/usr/bin/env bash

# Enhanced SGR hook with improved error handling and logging
# This script uses MCP SGR tool to enhance prompts with structured reasoning

set -euo pipefail  # Exit on error, undefined vars, pipe failures

# Get the project directory (Claude Code sets $CLAUDE_PROJECT_DIR)
PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$(pwd)}"
REQUESTS_DIR="${PROJECT_DIR}/requests"
ERROR_LOG="${PROJECT_DIR}/.claude/hooks/sgr_errors.log"

# Function to log errors
log_error() {
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] ERROR: $1" >> "$ERROR_LOG"
}

# Create directories if they don't exist
mkdir -p "$REQUESTS_DIR" 2>/dev/null || {
    log_error "Failed to create requests directory: $REQUESTS_DIR"
    exit 1
}

# Read the original user prompt from stdin (it's a JSON object)
JSON_INPUT=$(cat)

# Validate JSON input
if [ -z "$JSON_INPUT" ]; then
    log_error "Empty JSON input received"
    exit 1
fi

# Parse JSON with better error handling
if command -v jq &> /dev/null; then
    SESSION_ID=$(echo "$JSON_INPUT" | jq -r '.session_id // "N/A"' 2>/dev/null) || SESSION_ID="N/A"
    USER_PROMPT=$(echo "$JSON_INPUT" | jq -r '.prompt // ""' 2>/dev/null) || USER_PROMPT=""
else
    # Fallback to sed with better escaping
    SESSION_ID=$(echo "$JSON_INPUT" | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    USER_PROMPT=$(echo "$JSON_INPUT" | sed -n 's/.*"prompt"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    [ -z "$SESSION_ID" ] && SESSION_ID="N/A"
fi

# Generate unique filename with microseconds to avoid collisions
TIMESTAMP=$(date +"%Y%m%d%H%M%S%N" | cut -b1-17)  # YYYYMMDDHHMMSSmmm
LOG_FILE="${REQUESTS_DIR}/${TIMESTAMP}_request.md"

# Ensure unique filename (handle race conditions)
COUNTER=0
while [ -f "$LOG_FILE" ]; do
    COUNTER=$((COUNTER + 1))
    LOG_FILE="${REQUESTS_DIR}/${TIMESTAMP}_${COUNTER}_request.md"
    if [ $COUNTER -gt 10 ]; then
        log_error "Unable to create unique log file after 10 attempts"
        break
    fi
done

# Define context for SGR processing
CONTEXT='{
  "role": "Профессиональный разработчик фронтенд и бэкенд для домашнего учета",
  "domain_expertise": [
    "Modern web development (SvelteKit, TypeScript)",
    "Database design and optimization (PostgreSQL, FastApi)",
    "Docker containerization and microservices",
    "Testing strategies and CI/CD pipelines",
    "User experience and interface design"
  ],
  "operational_rules": [
    "Всегда проверяй существующий код перед изменениями",
    "Следуй архитектурным паттернам проекта",
    "Поддерживай консистентность кодовой базы",
    "Документируй важные решения",
    "Используй субагентов",
    "Уточняй информацию с использованием инструмента context7",
    "Фиксируй важные моменты в памяти с помощью инструмента memory",
    "Выполняй задачи шаг за шагом. Для рассуждения используй sequential-thinking"
  ],
  "project_specifics": {
    "frontend": "SvelteKit 2 + Svelte 5 with runes",
    "backend": "FastAPI + SQLAlchemy",
    "database": "PostgreSQL with partitioned tables",
    "development": "Docker-only environment"
  }
}'

# Determine schema based on prompt content
detect_schema() {
    local prompt="$1"
    
    # Keywords for different schemas
    if echo "$prompt" | grep -qiE "(debug|error|fix|исправ|ошибк|баг)"; then
        echo "debugging"
    elif echo "$prompt" | grep -qiE "(test|тест|проверк|coverage)"; then
        echo "testing"
    elif echo "$prompt" | grep -qiE "(implement|создай|добавь|разработ|функци)"; then
        echo "coding"
    elif echo "$prompt" | grep -qiE "(review|проверь|анализ|код-ревью)"; then
        echo "review"
    elif echo "$prompt" | grep -qiE "(architecture|архитектур|design|проектирован)"; then
        echo "architecture"
    elif echo "$prompt" | grep -qiE "(document|документ|readme|описан)"; then
        echo "documentation"
    elif echo "$prompt" | grep -qiE "(plan|планиров|стратег|roadmap)"; then
        echo "planning"
    else
        echo "analysis"
    fi
}

# Detect appropriate schema
SCHEMA_NAME=$(detect_schema "$USER_PROMPT")

# Escape special characters in USER_PROMPT for safe JSON embedding
ESCAPED_PROMPT=$(echo "$USER_PROMPT" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\n/\\n/g; s/\r/\\r/g; s/\t/\\t/g')

# Save the request to log file with atomic write
TMP_FILE="${LOG_FILE}.tmp"
cat > "$TMP_FILE" << EOF
# SGR Request Log - ${TIMESTAMP}

## Metadata
- Timestamp: $(date +"%Y-%m-%d %H:%M:%S.%N" | cut -b1-23)
- Session ID: ${SESSION_ID}
- Project: ${PROJECT_DIR}
- Selected Schema: ${SCHEMA_NAME}

## Original User Prompt
${USER_PROMPT}

## SGR Context
$(echo "$CONTEXT" | jq '.' 2>/dev/null || echo "$CONTEXT")

## Processing Status
- Schema Detection: Completed
- MCP SGR Integration: Active
- Log Creation: Success
EOF

# Atomic move to ensure file is complete
mv "$TMP_FILE" "$LOG_FILE" 2>/dev/null || {
    log_error "Failed to create log file: $LOG_FILE"
    rm -f "$TMP_FILE" 2>/dev/null
}

# Generate the enhanced prompt using MCP SGR
ENHANCED_PROMPT="
## 🎯 Task Processing with SGR

I will process your request using the Schema-Guided Reasoning (SGR) pattern with the **${SCHEMA_NAME}** schema.

### Original Request:
${USER_PROMPT}

### Processing Instructions:
1. I will use the mcp__sgr__generate_sgr_prompt tool to enhance this request
2. The SGR will provide structured reasoning steps
3. I will follow the enhanced prompt systematically

Let me process this request with SGR...

<!-- SGR_CONTEXT_START -->
Project Context:
- Frontend: SvelteKit 2 + Svelte 5
- Backend: FastAPI + SQLAlchemy  
- Database: PostgreSQL
- Environment: Docker-only development
- Schema Selected: ${SCHEMA_NAME}
<!-- SGR_CONTEXT_END -->

[Processing with mcp__sgr__generate_sgr_prompt...]
"

# Output the enhanced prompt for Claude Code
echo "$ENHANCED_PROMPT"

# Append the enhanced prompt to log file if it exists
if [ -f "$LOG_FILE" ]; then
    echo -e "\n## Enhanced Prompt Sent to Claude" >> "$LOG_FILE"
    echo "$ENHANCED_PROMPT" >> "$LOG_FILE"
    echo -e "\n## Log File Status: Successfully created" >> "$LOG_FILE"
fi

# Optional: Clean up old logs (keep last 100)
LOG_COUNT=$(find "$REQUESTS_DIR" -name "*.md" -type f 2>/dev/null | wc -l)
if [ "$LOG_COUNT" -gt 100 ]; then
    find "$REQUESTS_DIR" -name "*.md" -type f -printf '%T@ %p\n' | \
        sort -n | head -n -100 | cut -d' ' -f2- | xargs rm -f 2>/dev/null || true
fi

exit 0