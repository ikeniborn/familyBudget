{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://familybudget.local/schemas/deployment-output.json",
  "title": "Deployment Output Schema",
  "description": "JSON Schema для structured output deployment скрипта deploy-test.sh v2.0.1",
  "type": "object",
  "required": ["status", "timestamp", "server", "branch", "version", "attempts"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "FAILED", "CANCELLED", "IN_PROGRESS"],
      "description": "Статус deployment"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp deployment в ISO 8601 формате"
    },
    "server": {
      "type": "string",
      "const": "budget-test",
      "description": "Целевой сервер (всегда budget-test для deploy-test skill)"
    },
    "branch": {
      "type": "string",
      "const": "test",
      "description": "Git ветка (всегда test для deploy-test skill)"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Deployed версия в semver формате (X.Y.Z)"
    },
    "attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Количество попыток deployment"
    },
    "duration": {
      "type": "object",
      "required": ["total", "breakdown"],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Общее время deployment в секундах"
        },
        "breakdown": {
          "type": "object",
          "properties": {
            "ssh_check": {"type": "integer", "minimum": 0},
            "local_validation": {"type": "integer", "minimum": 0},
            "git_pull": {"type": "integer", "minimum": 0},
            "version_confirmation": {"type": "integer", "minimum": 0},
            "deploy_execution": {"type": "integer", "minimum": 0},
            "verification": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "deployment_details": {
      "type": "object",
      "required": ["mode", "max_retries", "auto_fix", "auto_commit"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["registry-first", "legacy-build"],
          "description": "Режим deployment (registry-first recommended)"
        },
        "version_bump": {
          "type": ["string", "null"],
          "enum": ["patch", "minor", "major", "none", null],
          "description": "Тип version bump (deprecated в registry-first)"
        },
        "force_build": {
          "type": "boolean",
          "description": "Принудительная пересборка (deprecated в registry-first)"
        },
        "max_retries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Максимум попыток deployment"
        },
        "auto_fix": {
          "type": "boolean",
          "description": "Автоматическое исправление проблем"
        },
        "auto_commit": {
          "type": "boolean",
          "description": "Автоматический commit исправлений"
        },
        "skip_local_validation": {
          "type": "boolean",
          "description": "Пропустить локальную валидацию"
        },
        "rollback_on_fail": {
          "type": "boolean",
          "description": "Откат при ошибке"
        }
      }
    },
    "version_info": {
      "type": "object",
      "description": "Информация о deployed версиях из IMAGE_VERSIONS.json",
      "required": ["backend", "bot", "nginx", "redis", "postgresql"],
      "properties": {
        "backend": {
          "$ref": "#/definitions/service_version"
        },
        "bot": {
          "$ref": "#/definitions/service_version"
        },
        "nginx": {
          "$ref": "#/definitions/service_version"
        },
        "redis": {
          "$ref": "#/definitions/service_version"
        },
        "postgresql": {
          "$ref": "#/definitions/service_version"
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["deployment_logs", "containers", "health_check"],
      "properties": {
        "deployment_logs": {
          "type": "object",
          "required": ["status", "errors_found"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["OK", "WARNING", "ERROR"]
            },
            "errors_found": {
              "type": "integer",
              "minimum": 0
            },
            "error_samples": {
              "type": "array",
              "items": {"type": "string"},
              "maxItems": 10
            }
          }
        },
        "containers": {
          "type": "object",
          "required": ["total", "healthy", "unhealthy", "details"],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "healthy": {
              "type": "integer",
              "minimum": 0
            },
            "unhealthy": {
              "type": "integer",
              "minimum": 0
            },
            "details": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/container_status"
              }
            }
          }
        },
        "health_check": {
          "type": "object",
          "required": ["backend", "postgres", "redis"],
          "properties": {
            "backend": {
              "$ref": "#/definitions/health_status"
            },
            "postgres": {
              "$ref": "#/definitions/health_status"
            },
            "redis": {
              "$ref": "#/definitions/health_status"
            }
          }
        },
        "running_processes": {
          "type": "object",
          "required": ["stuck_found", "total"],
          "properties": {
            "stuck_found": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "logs": {
      "type": "object",
      "required": ["main", "deploy_output"],
      "properties": {
        "main": {
          "type": "string",
          "description": "Путь к главному log файлу"
        },
        "deploy_output": {
          "type": "string",
          "description": "Путь к output файлу deployment"
        },
        "server_deploy": {
          "type": "string",
          "description": "Путь к server deployment log"
        },
        "containers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["service", "path"],
            "properties": {
              "service": {"type": "string"},
              "path": {"type": "string"}
            }
          }
        },
        "summary": {
          "type": "string",
          "description": "Путь к summary markdown файлу"
        }
      }
    },
    "recovery": {
      "type": "object",
      "description": "Информация о recovery attempts (если были)",
      "properties": {
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["attempt_number", "strategy", "result"],
            "properties": {
              "attempt_number": {
                "type": "integer",
                "minimum": 1
              },
              "strategy": {
                "type": "string",
                "enum": [
                  "container_restart",
                  "process_cleanup",
                  "network_retry",
                  "git_state_recovery",
                  "rollback"
                ]
              },
              "result": {
                "type": "string",
                "enum": ["SUCCESS", "FAILED", "SKIPPED"]
              },
              "delay": {
                "type": "integer",
                "minimum": 0,
                "description": "Задержка перед попыткой в секундах"
              },
              "details": {
                "type": "string",
                "description": "Дополнительные детали recovery"
              }
            }
          }
        },
        "rollback_performed": {
          "type": "boolean",
          "description": "Был ли выполнен rollback"
        },
        "rollback_version": {
          "type": ["string", "null"],
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Версия к которой откатились (если rollback)"
        }
      }
    },
    "errors": {
      "type": "array",
      "description": "Список ошибок если deployment failed",
      "items": {
        "type": "object",
        "required": ["type", "message", "severity"],
        "properties": {
          "type": {
            "type": "string",
            "description": "Тип ошибки"
          },
          "message": {
            "type": "string",
            "description": "Сообщение об ошибке"
          },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "ERROR", "WARNING"],
            "description": "Severity level"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "description": "Источник ошибки (step, service, etc)"
          }
        }
      }
    }
  },
  "definitions": {
    "service_version": {
      "type": "object",
      "required": ["version", "hash"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "hash": {
          "type": "string",
          "minLength": 8,
          "maxLength": 40,
          "description": "Git hash (короткий или полный)"
        },
        "lastModified": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "container_status": {
      "type": "object",
      "required": ["service", "status", "health"],
      "properties": {
        "service": {
          "type": "string",
          "enum": ["backend", "bot", "nginx", "redis", "postgres"]
        },
        "status": {
          "type": "string",
          "description": "Docker container status"
        },
        "health": {
          "type": "string",
          "enum": ["healthy", "unhealthy", "starting", "N/A"]
        }
      }
    },
    "health_status": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ok", "error", "timeout"]
        },
        "response_time": {
          "type": "integer",
          "minimum": 0,
          "description": "Response time в миллисекундах"
        },
        "message": {
          "type": "string",
          "description": "Дополнительное сообщение"
        }
      }
    }
  }
}
