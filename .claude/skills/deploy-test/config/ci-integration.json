{
  "_description": "CI/CD Integration configuration for GitHub Actions",
  "_version": "9.2.0",

  "github_actions": {
    "workflow_name": "build-and-push.yml",
    "workflow_path": ".github/workflows/build-and-push.yml",
    "branch": "test",
    "default_branch": "test",
    "default_timeout_minutes": 30,
    "polling_interval_seconds": 15,
    "required_jobs": [
      "check-version",
      "sync-version",
      "service-build",
      "quality-checks",
      "image-build-push",
      "security-scan",
      "summary"
    ],
    "blocking_jobs": [
      "quality-checks",
      "image-build-push"
    ],
    "status_check_command": "gh run list --workflow=build-and-push.yml --branch={branch} --limit 1 --json databaseId,status,conclusion,headSha,createdAt"
  },

  "monitoring": {
    "enabled_by_default": false,
    "require_gh_cli": true,
    "fallback_to_manual": true,
    "auto_abort_on_build_failure": true
  },

  "timeout_thresholds": {
    "warning_threshold_minutes": 20,
    "critical_threshold_minutes": 25,
    "max_timeout_minutes": 30
  },

  "status_mapping": {
    "completed_success": ["completed:success"],
    "completed_failure": ["completed:failure", "completed:cancelled", "completed:skipped"],
    "in_progress": ["queued", "in_progress", "waiting"],
    "unknown": ["requested"]
  },

  "error_messages": {
    "gh_cli_missing": "GitHub CLI (gh) не установлен или не аутентифицирован. Автоматический мониторинг GitHub Actions недоступен.",
    "no_workflow_run": "Workflow run не найден для ветки {branch}. Возможно GitHub Actions еще не запустился.",
    "build_failed": "GitHub Actions build завершился с ошибкой: {conclusion}",
    "build_timeout": "Timeout: GitHub Actions build не завершился за {timeout} минут",
    "api_error": "Ошибка при запросе к GitHub API: {error}"
  },

  "registry": {
    "url": "ghcr.io",
    "namespace": "ikeniborn",
    "images": [
      {
        "name": "familybudget-backend",
        "dockerfile": "backend/Dockerfile",
        "context": ".",
        "size_limit_mb": 600
      },
      {
        "name": "familybudget-bot",
        "dockerfile": "bot/Dockerfile",
        "context": ".",
        "size_limit_mb": 500
      },
      {
        "name": "familybudget-nginx",
        "dockerfile": "nginx/Dockerfile",
        "context": "nginx",
        "size_limit_mb": 100
      },
      {
        "name": "familybudget-redis",
        "dockerfile": "redis/Dockerfile",
        "context": "redis",
        "size_limit_mb": 100
      },
      {
        "name": "familybudget-postgresql",
        "dockerfile": "postgres/Dockerfile",
        "context": "postgres",
        "size_limit_mb": 300
      }
    ],
    "retention_days": 7,
    "cleanup_policy": "smart",
    "availability_check_command": "docker manifest inspect ghcr.io/ikeniborn/${IMAGE_NAME}:${VERSION}"
  },

  "version_management": {
    "version_file": "VERSION",
    "lockfile": "IMAGE_VERSIONS.json",
    "package_json": "package.json",
    "package_lock": "package-lock.json",
    "sync_command": "scripts/ci/sync_version.sh"
  },

  "selective_build": {
    "enabled": true,
    "lockfile": "IMAGE_VERSIONS.json",
    "check_script": "scripts/ci/check_image_changes.sh",
    "update_script": "scripts/ci/update_image_version.sh",
    "tracked_paths": {
      "backend": ["backend/", "frontend/", "package.json", "package-lock.json"],
      "bot": ["bot/"],
      "nginx": ["nginx/", "frontend/web/templates/", "frontend/web/static/"],
      "redis": ["redis/"],
      "postgresql": ["postgres/", "backend/alembic/"]
    }
  },

  "cache_busting": {
    "enabled": true,
    "script": "scripts/ci/cache_busting_ci.sh",
    "version_source": "VERSION",
    "pattern": "?v=PLACEHOLDER",
    "replacement": "?v=${VERSION}",
    "affected_files": 26,
    "validation_required": true
  },

  "deployment_history": {
    "log_file": "/opt/budget/logs/deployment-history.log",
    "format": "[${TIMESTAMP}] mode=registry tag=${VERSION} result=${RESULT} user=${USER}",
    "retention_days": 90
  }
}
