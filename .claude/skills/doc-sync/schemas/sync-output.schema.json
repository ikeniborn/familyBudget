{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Doc-Sync Output Schema",
  "description": "JSON Schema для валидации output структуры doc-sync навыка",
  "type": "object",
  "required": ["analysis", "updates", "changelog_entry"],
  "properties": {
    "analysis": {
      "type": "object",
      "description": "Результаты анализа git diff и code-to-docs mapping",
      "required": ["changed_files", "affected_docs", "staleness_issues"],
      "properties": {
        "changed_files": {
          "type": "integer",
          "description": "Количество изменённых файлов кода",
          "minimum": 0
        },
        "affected_docs": {
          "type": "integer",
          "description": "Количество затронутых документов",
          "minimum": 0
        },
        "staleness_issues": {
          "type": "integer",
          "description": "Количество обнаруженных проблем с устареванием",
          "minimum": 0
        },
        "changed_components": {
          "type": "array",
          "description": "Список изменённых компонентов",
          "items": {
            "$ref": "#/definitions/ChangedComponent"
          }
        }
      }
    },
    "updates": {
      "type": "array",
      "description": "Список обновлений документации",
      "items": {
        "$ref": "#/definitions/DocumentUpdate"
      }
    },
    "changelog_entry": {
      "type": "string",
      "description": "Сгенерированная запись для changelog в docs/architecture/README.md"
    },
    "commit_sha": {
      "type": "string",
      "description": "SHA коммита с обновлениями документации (если применено)",
      "pattern": "^[a-f0-9]{7,40}$"
    }
  },
  "definitions": {
    "ChangedComponent": {
      "type": "object",
      "description": "Изменённый компонент кода",
      "required": ["type", "file", "affected_docs"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["api_endpoint", "database_model", "frontend_module", "template"],
          "description": "Тип компонента"
        },
        "file": {
          "type": "string",
          "description": "Путь к файлу с изменениями"
        },
        "name": {
          "type": "string",
          "description": "Имя компонента (endpoint path, model name, module name)"
        },
        "affected_docs": {
          "type": "array",
          "description": "Список затронутых документов",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "signature": {
          "type": "object",
          "description": "Извлечённая сигнатура компонента",
          "properties": {
            "path": {"type": "string"},
            "method": {"type": "string"},
            "auth": {"type": "string"},
            "query_params": {"type": "array"},
            "response_model": {"type": "string"}
          }
        }
      }
    },
    "DocumentUpdate": {
      "type": "object",
      "description": "Обновление документа",
      "required": ["file", "action", "preview"],
      "properties": {
        "file": {
          "type": "string",
          "description": "Путь к документу (относительно корня проекта)"
        },
        "action": {
          "type": "string",
          "enum": ["add_route", "update_route", "add_table", "update_table", "add_module", "update_module", "add_changelog"],
          "description": "Тип действия"
        },
        "preview": {
          "type": "string",
          "description": "Preview изменений (YAML snippet или diff)"
        },
        "approved": {
          "type": "boolean",
          "description": "Подтверждено ли обновление пользователем"
        },
        "applied": {
          "type": "boolean",
          "description": "Применено ли обновление"
        },
        "backup_path": {
          "type": "string",
          "description": "Путь к backup файлу (если создан)"
        }
      }
    }
  }
}
