{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Test Input Schema",
  "description": "Input schema для test-code skill: git diff context и test categories",
  "type": "object",
  "properties": {
    "test_input": {
      "type": "object",
      "properties": {
        "git_diff_context": {
          "type": "object",
          "properties": {
            "backend_changed": {
              "type": "boolean",
              "description": "Backend files изменены (backend/)"
            },
            "frontend_changed": {
              "type": "boolean",
              "description": "Frontend files изменены (frontend/)"
            },
            "e2e_changed": {
              "type": "boolean",
              "description": "E2E test files изменены (tests/e2e/)"
            },
            "dependencies_changed": {
              "type": "boolean",
              "description": "Dependencies изменены (package.json, requirements.txt)"
            },
            "ci_changed": {
              "type": "boolean",
              "description": "CI/CD workflows изменены (.github/workflows/)"
            },
            "changed_files": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Список изменённых файлов"
            }
          },
          "required": [
            "backend_changed",
            "frontend_changed",
            "e2e_changed",
            "dependencies_changed",
            "ci_changed",
            "changed_files"
          ]
        },
        "test_categories": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["syntax", "quality", "runtime", "dependencies", "e2e"]
          },
          "description": "Категории тестов для запуска"
        },
        "autofix_enabled": {
          "type": "boolean",
          "default": true,
          "description": "Включить автоматические исправления"
        },
        "e2e_strategy": {
          "type": "string",
          "enum": ["full", "smoke", "skip"],
          "default": "full",
          "description": "Стратегия E2E тестирования"
        },
        "coverage_threshold": {
          "type": "object",
          "properties": {
            "backend_lines": {
              "type": "number",
              "minimum": 30.0,
              "description": "Backend coverage threshold (lines %)"
            },
            "frontend_lines": {
              "type": "number",
              "minimum": 4.0,
              "description": "Frontend coverage threshold (lines %)"
            },
            "frontend_functions": {
              "type": "number",
              "minimum": 32.0,
              "description": "Frontend coverage threshold (functions %)"
            }
          },
          "required": ["backend_lines", "frontend_lines", "frontend_functions"]
        }
      },
      "required": [
        "git_diff_context",
        "test_categories",
        "autofix_enabled",
        "e2e_strategy",
        "coverage_threshold"
      ]
    }
  },
  "required": ["test_input"]
}
