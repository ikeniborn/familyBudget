{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Test Output Schema",
  "description": "Output schema для test-code skill: test results, autofix proposals, TOON format",
  "type": "object",
  "properties": {
    "test_output": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["passed", "partial", "failed"],
          "description": "Общий статус тестирования"
        },
        "total_duration": {
          "type": "string",
          "pattern": "^\\d+m \\d+s$",
          "description": "Общее время выполнения (формат: 7m 18s)"
        },
        "stages": {
          "type": "object",
          "properties": {
            "syntax_validation": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": ["passed", "failed", "warning"]
                },
                "python": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string", "enum": ["passed", "failed"]},
                    "errors": {"type": "array", "items": {"type": "object"}}
                  },
                  "required": ["status", "errors"]
                },
                "typescript": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string", "enum": ["passed", "failed"]},
                    "errors": {"type": "array", "items": {"type": "object"}}
                  },
                  "required": ["status", "errors"]
                },
                "json": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string", "enum": ["passed", "failed"]},
                    "errors": {"type": "array", "items": {"type": "object"}}
                  },
                  "required": ["status", "errors"]
                },
                "yaml": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string", "enum": ["passed", "warning"]},
                    "warnings": {"type": "array", "items": {"type": "string"}}
                  },
                  "required": ["status", "warnings"]
                }
              },
              "required": ["status", "python", "typescript", "json", "yaml"]
            },
            "quality_checks": {
              "type": "object",
              "properties": {
                "status": {"type": "string", "enum": ["passed", "failed", "warning"]},
                "ruff": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string", "enum": ["passed", "failed"]},
                    "errors": {"type": "number"},
                    "fixable": {"type": "number"},
                    "details": {"type": "array", "items": {"type": "object"}}
                  },
                  "required": ["status", "errors", "fixable", "details"]
                },
                "mypy": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string", "enum": ["passed", "warning"]},
                    "errors": {"type": "number"},
                    "blocking": {"type": "boolean"}
                  },
                  "required": ["status", "errors", "blocking"]
                },
                "eslint": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string", "enum": ["passed", "warning"]},
                    "warnings": {"type": "number"},
                    "threshold": {"type": "number"}
                  },
                  "required": ["status", "warnings", "threshold"]
                }
              },
              "required": ["status", "ruff", "mypy", "eslint"]
            },
            "runtime_testing": {
              "type": "object",
              "properties": {
                "status": {"type": "string", "enum": ["passed", "partial", "failed"]},
                "backend_pytest": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string", "enum": ["passed", "partial", "failed"]},
                    "total_tests": {"type": "number"},
                    "passed": {"type": "number"},
                    "failed": {"type": "number"},
                    "skipped": {"type": "number"},
                    "coverage": {
                      "type": "object",
                      "properties": {
                        "lines": {"type": "number"},
                        "threshold": {"type": "number"},
                        "passed": {"type": "boolean"}
                      },
                      "required": ["lines", "threshold", "passed"]
                    },
                    "known_failing_tests": {
                      "type": "array",
                      "items": {"type": "string"}
                    }
                  },
                  "required": ["status", "total_tests", "passed", "failed", "skipped", "coverage"]
                },
                "frontend_vitest": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string", "enum": ["passed", "failed"]},
                    "total_tests": {"type": "number"},
                    "passed": {"type": "number"},
                    "failed": {"type": "number"},
                    "coverage": {
                      "type": "object",
                      "properties": {
                        "lines": {"type": "number"},
                        "functions": {"type": "number"},
                        "branches": {"type": "number"},
                        "statements": {"type": "number"}
                      },
                      "required": ["lines", "functions", "branches", "statements"]
                    }
                  },
                  "required": ["status", "total_tests", "passed", "failed", "coverage"]
                }
              },
              "required": ["status", "backend_pytest", "frontend_vitest"]
            },
            "dependency_validation": {
              "type": "object",
              "properties": {
                "status": {"type": "string", "enum": ["passed", "warning", "failed"]},
                "backend_pip": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string", "enum": ["passed", "warning", "failed"]},
                    "lockfile_consistent": {"type": "boolean"},
                    "security_vulnerabilities": {"type": "number"},
                    "vulnerabilities": {"type": "array", "items": {"type": "object"}}
                  },
                  "required": ["status", "lockfile_consistent", "security_vulnerabilities"]
                },
                "frontend_npm": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string", "enum": ["passed", "warning", "failed"]},
                    "lockfile_consistent": {"type": "boolean"},
                    "security_vulnerabilities": {"type": "number"},
                    "vulnerabilities": {"type": "array", "items": {"type": "object"}},
                    "outdated_packages": {"type": "number"}
                  },
                  "required": ["status", "lockfile_consistent", "security_vulnerabilities"]
                }
              },
              "required": ["status", "backend_pip", "frontend_npm"]
            },
            "e2e_testing": {
              "type": "object",
              "properties": {
                "status": {"type": "string", "enum": ["passed", "failed"]},
                "total_tests": {"type": "number"},
                "passed": {"type": "number"},
                "failed": {"type": "number"},
                "duration": {"type": "string"},
                "projects": {
                  "type": "object",
                  "properties": {
                    "setup": {
                      "type": "object",
                      "properties": {
                        "status": {"type": "string", "enum": ["passed", "failed"]},
                        "duration": {"type": "string"}
                      },
                      "required": ["status", "duration"]
                    },
                    "chromium": {
                      "type": "object",
                      "properties": {
                        "status": {"type": "string", "enum": ["passed", "failed"]},
                        "tests": {"type": "number"},
                        "duration": {"type": "string"}
                      },
                      "required": ["status", "tests", "duration"]
                    },
                    "firefox": {
                      "type": "object",
                      "properties": {
                        "status": {"type": "string", "enum": ["passed", "failed"]},
                        "tests": {"type": "number"},
                        "duration": {"type": "string"}
                      },
                      "required": ["status", "tests", "duration"]
                    },
                    "webkit": {
                      "type": "object",
                      "properties": {
                        "status": {"type": "string", "enum": ["passed", "failed"]},
                        "tests": {"type": "number"},
                        "duration": {"type": "string"}
                      },
                      "required": ["status", "tests", "duration"]
                    },
                    "mobile_chrome": {
                      "type": "object",
                      "properties": {
                        "status": {"type": "string", "enum": ["passed", "failed"]},
                        "tests": {"type": "number"},
                        "duration": {"type": "string"}
                      },
                      "required": ["status", "tests", "duration"]
                    },
                    "mobile_safari": {
                      "type": "object",
                      "properties": {
                        "status": {"type": "string", "enum": ["passed", "failed"]},
                        "tests": {"type": "number"},
                        "duration": {"type": "string"}
                      },
                      "required": ["status", "tests", "duration"]
                    }
                  },
                  "required": ["setup", "chromium", "firefox", "webkit", "mobile_chrome", "mobile_safari"]
                },
                "test_files": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              },
              "required": ["status", "total_tests", "passed", "failed", "duration", "projects", "test_files"]
            }
          },
          "required": ["syntax_validation", "quality_checks", "runtime_testing", "dependency_validation", "e2e_testing"]
        },
        "critical_issues": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Критические проблемы (blocking)"
        },
        "warnings": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Предупреждения (non-blocking)"
        },
        "autofix_proposals": {
          "type": "array",
          "items": {"type": "object"},
          "description": "Предложения по автоисправлению"
        },
        "toon": {
          "type": "object",
          "properties": {
            "test_results_toon": {"type": "string"},
            "token_savings": {"type": "string"},
            "size_comparison": {"type": "string"}
          },
          "description": "TOON format для >= 5 test results (опционально)"
        }
      },
      "required": ["status", "total_duration", "stages", "critical_issues", "warnings", "autofix_proposals"]
    }
  },
  "required": ["test_output"]
}
