{
  "test_output": {
    "status": "{{status: enum passed|partial|failed}}",
    "total_duration": "{{total_duration: string, pattern /^\\d+m \\d+s$/}}",
    "stages": {
      "syntax_validation": {
        "status": "{{status: enum passed|failed|warning}}",
        "python": {
          "status": "{{status: enum passed|failed}}",
          "errors": "{{errors: array of objects}}"
        },
        "typescript": {
          "status": "{{status: enum passed|failed}}",
          "errors": "{{errors: array of objects}}"
        },
        "json": {
          "status": "{{status: enum passed|failed}}",
          "errors": "{{errors: array of objects}}"
        },
        "yaml": {
          "status": "{{status: enum passed|warning}}",
          "warnings": "{{warnings: array of strings}}"
        }
      },
      "quality_checks": {
        "status": "{{status: enum passed|failed|warning}}",
        "ruff": {
          "status": "{{status: enum passed|failed}}",
          "errors": "{{errors: number}}",
          "fixable": "{{fixable: number}}",
          "details": "{{details: array of objects}}"
        },
        "mypy": {
          "status": "{{status: enum passed|warning}}",
          "errors": "{{errors: number}}",
          "blocking": "{{blocking: boolean}}"
        },
        "eslint": {
          "status": "{{status: enum passed|warning}}",
          "warnings": "{{warnings: number}}",
          "threshold": "{{threshold: number}}"
        }
      },
      "runtime_testing": {
        "status": "{{status: enum passed|partial|failed}}",
        "backend_pytest": {
          "status": "{{status: enum passed|partial|failed}}",
          "total_tests": "{{total_tests: number}}",
          "passed": "{{passed: number}}",
          "failed": "{{failed: number}}",
          "skipped": "{{skipped: number}}",
          "coverage": {
            "lines": "{{lines: number}}",
            "threshold": "{{threshold: number}}",
            "passed": "{{passed: boolean}}"
          },
          "known_failing_tests": "{{optional: array of strings}}"
        },
        "frontend_vitest": {
          "status": "{{status: enum passed|failed}}",
          "total_tests": "{{total_tests: number}}",
          "passed": "{{passed: number}}",
          "failed": "{{failed: number}}",
          "coverage": {
            "lines": "{{lines: number}}",
            "functions": "{{functions: number}}",
            "branches": "{{branches: number}}",
            "statements": "{{statements: number}}"
          }
        }
      },
      "dependency_validation": {
        "status": "{{status: enum passed|warning|failed}}",
        "backend_pip": {
          "status": "{{status: enum passed|warning|failed}}",
          "lockfile_consistent": "{{lockfile_consistent: boolean}}",
          "security_vulnerabilities": "{{security_vulnerabilities: number}}",
          "vulnerabilities": "{{optional: array of objects}}"
        },
        "frontend_npm": {
          "status": "{{status: enum passed|warning|failed}}",
          "lockfile_consistent": "{{lockfile_consistent: boolean}}",
          "security_vulnerabilities": "{{security_vulnerabilities: number}}",
          "vulnerabilities": "{{optional: array of objects}}",
          "outdated_packages": "{{optional: number}}"
        }
      },
      "e2e_testing": {
        "status": "{{status: enum passed|failed}}",
        "total_tests": "{{total_tests: number}}",
        "passed": "{{passed: number}}",
        "failed": "{{failed: number}}",
        "duration": "{{duration: string}}",
        "projects": {
          "setup": {
            "status": "{{status: enum passed|failed}}",
            "duration": "{{duration: string}}"
          },
          "chromium": {
            "status": "{{status: enum passed|failed}}",
            "tests": "{{tests: number}}",
            "duration": "{{duration: string}}"
          },
          "firefox": {
            "status": "{{status: enum passed|failed}}",
            "tests": "{{tests: number}}",
            "duration": "{{duration: string}}"
          },
          "webkit": {
            "status": "{{status: enum passed|failed}}",
            "tests": "{{tests: number}}",
            "duration": "{{duration: string}}"
          },
          "mobile_chrome": {
            "status": "{{status: enum passed|failed}}",
            "tests": "{{tests: number}}",
            "duration": "{{duration: string}}"
          },
          "mobile_safari": {
            "status": "{{status: enum passed|failed}}",
            "tests": "{{tests: number}}",
            "duration": "{{duration: string}}"
          }
        },
        "test_files": "{{test_files: array of strings}}"
      }
    },
    "critical_issues": "{{critical_issues: array of strings}}",
    "warnings": "{{warnings: array of strings}}",
    "autofix_proposals": "{{autofix_proposals: array of objects}}",
    "toon": {
      "test_results_toon": "{{optional: string}}",
      "token_savings": "{{optional: string}}",
      "size_comparison": "{{optional: string}}"
    }
  }
}
