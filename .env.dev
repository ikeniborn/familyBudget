# Development Environment Variables
# Copy this to .env for local development

# Domain Configuration (for local development)
DOMAIN=localhost
FRONTEND_SUBDOMAIN=app
FRONTEND_API_SUBDOMAIN=api
# Legacy subdomain (can be removed after full migration)
BUDGET_API_SUBDOMAIN=api-legacy

# Database
# POSTGRES_PASSWORD - PostgreSQL superuser password (for admin tasks)
POSTGRES_PASSWORD=devpassword
# BUDGET_DB_PASSWORD - Application database user password (for budget user)
BUDGET_DB_PASSWORD=devpassword

# Frontend API
SESSION_SECRET=dev-session-secret-change-in-production
TELEGRAM_BOT_TOKEN=your_dev_telegram_bot_token

# JWT Configuration
JWT_SECRET=dev-jwt-secret-key-at-least-32-chars-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-key-at-least-32-chars-change-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Enable password authentication alongside Telegram
ENABLE_PASSWORD_AUTH=true

# Node Environment
NODE_ENV=development

# Feature Flags
USE_UNIFIED_API=true

# Development URLs
VITE_API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Database URL for Prisma
DATABASE_URL=postgresql://budget:devpassword@localhost:5432/budgetdb

# Redis Configuration  
REDIS_HOST=localhost
REDIS_PORT=6379

# Svelte Frontend Development
PUBLIC_API_URL=http://localhost:4000
# ORIGIN is set automatically by SvelteKit in development