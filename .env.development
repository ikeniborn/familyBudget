# Development Environment Variables
# Copy this to .env for local development

# Domain Configuration (for local development with Traefik)
DOMAIN=localhost
BUDGET_API_SUBDOMAIN=api
FRONTEND_SUBDOMAIN=app
FRONTEND_API_SUBDOMAIN=api-app

# Database
# POSTGRES_PASSWORD - PostgreSQL superuser password (for admin tasks)
POSTGRES_PASSWORD=devpassword
# BUDGET_DB_PASSWORD - Application database user password (for budget user)
BUDGET_DB_PASSWORD=devpassword

# Frontend API
SESSION_SECRET=dev-session-secret-change-in-production
TELEGRAM_BOT_TOKEN=your_dev_telegram_bot_token

# Development URLs
VITE_API_URL=http://localhost:4000
BACKEND_API_URL=http://localhost:8888

# Security Settings
SECURE_API=true

# Redis Configuration  
REDIS_HOST=redis
REDIS_PORT=6379