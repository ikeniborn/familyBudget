# Family Budget Environment Variables

# Common
USER_ID=1000
GROUP_ID=1000

# PostgreSQL (main database)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
PGDATA=/var/lib/postgresql/data/pgdata

# PostgreSQL (budget database)
POSTGRES_HOST=10.5.0.2
POSTGRES_PORT=5432
POSTGRES_DB_BUDGET=budgetdb
POSTGRES_USER_BUDGET=budget
POSTGRES_PASSWORD_BUDGET=your_secure_password_here

# CouchDB
COUCHDB_USER=admin
COUCHDB_PASSWORD=your_secure_password_here

# Redis
REDIS_HOST=10.5.0.5
REDIS_PORT=6379
REDIS_DB=0

# Traefik
TRAEFIK_DOMAIN=yourdomain.com
ACME_EMAIL=your-email@example.com
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD=your_secure_password_here

# API
API_URL=https://api.yourdomain.com
JWT_SECRET_KEY=your-256-bit-secret-key-change-this-in-production

# UI
POLARS_SKIP_CPU_CHECK=false