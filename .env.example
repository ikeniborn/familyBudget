# Family Budget - Environment Variables
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env file to git!

# =============================================================================
# APPLICATION
# =============================================================================

# Environment (development, staging, production)
APP_ENV=production

# Debug mode (true/false) - NEVER enable in production
DEBUG=false

# Application version (auto-updated by deploy.sh from VERSION file)
# Do not set manually - managed by versioning system
VERSION=

# Domain name (used for WebApp URL generation in bot)
# Production: your-domain.com (without https://)
# Development: localhost
DOMAIN=localhost

# Deployment Profile (basic, full)
# basic: PostgreSQL + Backend only
# full: PostgreSQL + Backend + Nginx + Bot + Certbot (SSL)
DEPLOYMENT_PROFILE=basic

# Web Workers Feature Flag
# Enable Web Workers for offloading heavy computations to background threads
# Improves main thread responsiveness and page performance
# Set to false to disable all workers (automatic fallback to synchronous processing)
# Default: true (recommended for production)
ENABLE_WEB_WORKERS=true

# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL Database
POSTGRES_DB=familybudget
POSTGRES_USER=familybudget
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# PostgreSQL Performance Tuning
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=128MB

# External PostgreSQL Access
# WARNING: Port 5432 is exposed in Docker, but blocked by UFW firewall by default
# Only enable if you need external access (e.g., for pgAdmin, remote tools)
# If enabled, setup.sh will configure UFW to allow access ONLY from specific IP
POSTGRES_EXTERNAL_ACCESS=false
POSTGRES_ALLOWED_IP=

# Database URL (auto-generated, no need to change)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# =============================================================================
# SECURITY
# =============================================================================

# JWT Secret Key
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# JWT Algorithm
JWT_ALGORITHM=HS256

# JWT Token Expiration (days)
JWT_EXPIRE_DAYS=7

# Internal API Key (for bot-to-backend communication)
# Generate with: openssl rand -hex 32
API_INTERNAL_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL

# =============================================================================
# TELEGRAM BOT
# =============================================================================

# Telegram Bot Token
# Get from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram Bot Username (REQUIRED for web login)
# Get from @BotFather (without @ prefix)
# Example: ikenibornbudgetbot
TELEGRAM_BOT_USERNAME=your_bot_username

# Telegram Webhook URL (optional, for webhook mode)
# Example: https://your-domain.com/api/v1/bot/webhook
TELEGRAM_WEBHOOK_URL=

# =============================================================================
# ADMIN
# =============================================================================

# Admin Telegram ID
# Get your Telegram ID from @userinfobot
ADMIN_TELEGRAM_ID=123456789

# =============================================================================
# BACKEND
# =============================================================================

# Backend Port
BACKEND_PORT=8000

# Number of Uvicorn workers
# With Redis Pub/Sub enabled, multi-worker deployment is supported
# Workers share WebSocket events via Redis Pub/Sub channel (budget:events)
# Recommended: 2-4 workers for production, 1 for development
# Falls back to single-worker mode if Redis is unavailable
WORKERS=4

# Max database connections
MAX_CONNECTIONS=100

# Log Level (debug, info, warning, error, critical) - lowercase required by uvicorn
LOG_LEVEL=info

# Log Format (json, text)
LOG_FORMAT=json

# =============================================================================
# TIMEZONE
# =============================================================================

# System timezone for scheduler and default user timezone
# IANA format (e.g., Europe/Moscow, America/New_York, UTC)
# This affects:
# - APScheduler job times (weekly reports, threshold checks)
# - Default timezone for new users
# - Date calculations in notification services
# - Default: UTC (recommended for production)
SYSTEM_TIMEZONE=UTC

# =============================================================================
# CORS
# =============================================================================

# Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,https://your-domain.com

# =============================================================================
# PUSH NOTIFICATIONS (VAPID)
# =============================================================================

# VAPID keys for Web Push notifications
# Generate with: python3 -c "from pywebpush import webpush; from py_vapid import Vapid; v = Vapid(); v.generate_keys(); print(f'VAPID_PUBLIC_KEY={v.public_key}'); print(f'VAPID_PRIVATE_KEY={v.private_key}')"
# Or run: ./scripts/generate_vapid_keys.sh
# These keys are generated ONCE per server and shared by all users
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact email for VAPID (required by Web Push spec)
# Used by push services to contact you if there are issues
VAPID_CONTACT_EMAIL=admin@your-domain.com

# =============================================================================
# S3 BACKUP (Optional)
# =============================================================================

# S3-compatible storage endpoint
# Examples:
# - AWS S3: leave empty (uses default)
# - DigitalOcean Spaces: https://nyc3.digitaloceanspaces.com
# - Backblaze B2: https://s3.us-west-002.backblazeb2.com
S3_ENDPOINT_URL=

# S3 Credentials
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# S3 Bucket Name
S3_BUCKET_NAME=familybudget-backups

# S3 Region
S3_REGION=us-east-1

# =============================================================================
# DIRECTORIES
# =============================================================================

# Backup directory
# IMPORTANT: Use absolute paths to prevent volume corruption on container restarts
BACKUP_DIR=/opt/budget/backups

# =============================================================================
# NGINX (Optional - only if using nginx profile)
# =============================================================================

# HTTP Port
HTTP_PORT=80

# HTTPS Port
HTTPS_PORT=443

# SSL Certificate Type (none, letsencrypt, self-signed, existing)
# none: No SSL (HTTP only) - for basic profile or testing
# letsencrypt: Automatic SSL via Let's Encrypt - recommended for production
# self-signed: Self-signed certificate - for development
# existing: Use existing certificates
SSL_TYPE=none

# Let's Encrypt Email (required if SSL_TYPE=letsencrypt)
# This email will be used for certificate expiration notifications
LETSENCRYPT_EMAIL=admin@your-domain.com

# =============================================================================
# PYTHON
# =============================================================================

# Python Version
PYTHON_VERSION=3.11

# =============================================================================
# MONITORING (Optional)
# =============================================================================

# Enable Prometheus metrics
PROMETHEUS_ENABLED=false

# Prometheus port
PROMETHEUS_PORT=9090

# =============================================================================
# REDIS (Caching & WebSocket Sync)
# =============================================================================

# Redis URL (auto-configured by setup.sh)
# Format: redis://[:password@]host:port/db
REDIS_URL=redis://redis:6379/0

# Redis password (optional but recommended for production)
# Generate with: openssl rand -hex 16
REDIS_PASSWORD=

# Redis memory limit (e.g., 256mb, 512mb, 1gb)
REDIS_MAXMEMORY=256mb

# Cache TTL defaults (seconds)
REDIS_CACHE_TTL_DEFAULT=60
REDIS_CACHE_TTL_REFERENCE=300
REDIS_CACHE_TTL_DASHBOARD=30

# Write-Behind Queue Configuration
# Enables async writes to PostgreSQL for lower latency
WRITE_BEHIND_ENABLED=true
WRITE_BEHIND_MAX_RETRIES=3
WRITE_BEHIND_BATCH_SIZE=100
# Dead Letter Queue (DLQ) settings
WRITE_BEHIND_DLQ_TTL_DAYS=7
WRITE_BEHIND_DLQ_MAX_SIZE=100

# =============================================================================
# DOCKER CPU LIMITS
# =============================================================================

# Auto-detected during setup.sh based on available CPU cores
# These values are dynamically calculated for optimal performance

# Number of available CPUs (detected by setup.sh)
CPU_COUNT=1

# Backend service CPU limits (main workload - 80% priority)
BACKEND_CPU_LIMIT=0.8
BACKEND_CPU_RESERVATION=0.3

# Bot service CPU limits (lightweight - 15% priority)
BOT_CPU_LIMIT=0.15
BOT_CPU_RESERVATION=0.05

# Nginx service CPU limits (proxy only - 5% priority)
NGINX_CPU_LIMIT=0.05
NGINX_CPU_RESERVATION=0.01

# Redis service CPU limits (caching - 10% priority)
REDIS_CPU_LIMIT=0.1
REDIS_CPU_RESERVATION=0.02

# NOTE: These are default values for single-CPU servers
# setup.sh will automatically adjust these based on your CPU count:
# - 1 CPU: Conservative limits (total ≤ 1.0)
# - 2 CPUs: Balanced limits (total ≤ 2.0)
# - 4+ CPUs: High-performance limits (scales with CPU count)

# =============================================================================
# NOTES
# =============================================================================

# Required variables:
# - POSTGRES_PASSWORD
# - JWT_SECRET
# - API_INTERNAL_KEY
# - TELEGRAM_BOT_TOKEN
# - TELEGRAM_BOT_USERNAME
# - ADMIN_TELEGRAM_ID

# Optional variables:
# - All S3 variables (if you want cloud backups)
# - POSTGRES_EXTERNAL_ACCESS (if you need external DB access)
# - NGINX variables (if using nginx profile)

# Security checklist:
# ✓ Generated strong POSTGRES_PASSWORD (min 20 characters)
# ✓ Generated JWT_SECRET with openssl rand -hex 32
# ✓ Generated API_INTERNAL_KEY with openssl rand -hex 32
# ✓ Set correct ADMIN_TELEGRAM_ID
# ✓ Set correct TELEGRAM_BOT_USERNAME
# ✓ NEVER commit .env file to git
# ✓ Restrict file permissions: chmod 600 .env
# ✓ PostgreSQL port exposed but protected by UFW firewall
# ✓ Only enable POSTGRES_EXTERNAL_ACCESS if absolutely necessary
