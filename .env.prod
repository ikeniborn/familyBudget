# Domain Configuration
DOMAIN=example.com
FRONTEND_SUBDOMAIN=app
FRONTEND_API_SUBDOMAIN=api
# Legacy subdomain for backward compatibility (remove after full migration)
BUDGET_API_SUBDOMAIN=api-legacy

# Database
# POSTGRES_PASSWORD - PostgreSQL superuser password (for admin tasks)
POSTGRES_PASSWORD=your_secure_postgres_password
# BUDGET_DB_PASSWORD - Application database user password (for budget user)
BUDGET_DB_PASSWORD=your_secure_budget_password

# Frontend API
SESSION_SECRET=your_secure_session_secret
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password
# Enable password authentication alongside Telegram
ENABLE_PASSWORD_AUTH=true

# Application Path (optional, defaults to current directory)
# APP_PATH=/opt/familybudget

# Node Environment
NODE_ENV=production

# Feature Flags
USE_UNIFIED_API=true

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password_if_needed

# Database URL (automatically constructed for production)
# For development, uncomment and modify:
# DATABASE_URL=postgresql://budget:password@localhost:5432/budgetdb

# Development URLs (optional, for local development)
# VITE_API_URL=http://localhost:4000
# FRONTEND_URL=http://localhost:3000