# E2E Test Environment Variables
# Copy this file to .env.test and fill with actual credentials
# .env.test is excluded from git for security

# Test User Credentials (create user via docs/testing/e2e-test-user-setup.md)
TEST_USER_EMAIL=e2e-test-1@example.com
TEST_USER_PASSWORD=E2eTestPassword123!

# Base URL for E2E tests (default: production)
BASE_URL=https://fbd.ikeniborn.ru

# Optional: CI/CD mode (set to "true" in GitHub Actions)
CI=false
