# =============================================================================
# Node.js & JavaScript
# =============================================================================

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs
lib-cov

# Coverage directory
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage
.grunt

# Bower dependency directory
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Isolated npm environment (created by install.sh)
.npm-isolated/

# TypeScript
typings/
*.tsbuildinfo
*.d.ts.map
# Temporary files from TypeScript compilation (minify.sh)
*.temp.js

# DO NOT ignore custom type definitions
!types/**/*.d.ts

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache
.cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Clasp
.clasprc.json

# =============================================================================
# Python
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
.vite-build/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python lib/ directory (but NOT scripts/lib/)
lib/
!scripts/lib/

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Virtual environments
venv/
ENV/
env/
.venv

# =============================================================================
# Database
# =============================================================================

# SQLite databases
*.db
*.sqlite
*.sqlite3

# Legacy data directory (PostgreSQL now uses Docker managed volume)
# Only ignore root-level data/ directory, not subdirectories like sql/data/
/data/

# Database dumps and backups
backups/
*.dump

# SQL Schema Files (NOT ignored - must be in git!)
!backend/db/schema/*.sql

# SQL directory - exclude temporary files
sql/venv/
sql/__pycache__/
sql/data/*.csv
sql/data/*.dump
sql/*.pyc

# Minified files (build artifacts) - excluding vendor/
# Vendor source files (.css, .js) are tracked, minified versions generated on build
frontend/web/static/css/*.min.css
frontend/web/static/css/vendor/*.min.css
frontend/shared/static/css/*.min.css

# Tailwind generated unminified CSS (intermediate build artifact)
# This file is generated from tailwind.input.css and then minified to tailwind-daisyui.min.css
frontend/web/static/css/tailwind-daisyui.css
frontend/**/static/js/**/*.min.js
frontend/**/static/js/**/*.min.js.map
# Pre-compiled offline bundles (no TS source in repo — built externally, must be committed)
!frontend/web/static/js/offline/offlineManager.min.js
!frontend/web/static/js/offline/offlineManager.min.js.map
# PGlite lazy-loaded chunks and bundles (built by Vite in CI/CD)
frontend/shared/db/assets/
frontend/shared/db/*.min.js
frontend/shared/db/*.min.js.map
# Service Worker minified (generated during deploy)
sw.min.js
sw.min.js.map
sw.min.js.gz

# Vite bundle files and sourcemaps (build artifacts)
# These files are built in CI/CD and embedded in Docker images
frontend/**/static/**/*.bundle.js
frontend/**/static/**/*.bundle.js.map
*.bundle.js
*.bundle.js.map

# Vite build output directories
frontend/web/static/js/dist/
frontend/webapp/static/js/dist/

# =============================================================================
# Docker & Infrastructure
# =============================================================================

# Docker Compose override
docker-compose.override.yml

# HAProxy certificates
**/haproxy/certs

# =============================================================================
# Environment & Configuration
# =============================================================================

# Environment variables
.env
.env.test
.env.local
.envrc

# Allow example environment files
!.env.dev
!.env.example

# Environment backups from setup.sh
.env.backup.*

# =============================================================================
# Security & Certificates
# =============================================================================

# SSL certificates and keys
*.pem
*.key
*.crt
certbot/

# =============================================================================
# Project-specific (Family Budget)
# =============================================================================

# Deployment state files (generated during deployment)
.last_deployed_version
.migration_checksums
.cache-version
sw.prepared.js

# Nginx generated configs (auto-generated from templates)
nginx/conf.d/app.conf

# Deployment script backups from refactoring phases
*.phase*-backup

# Temporary sync script (deprecated)
**/sync_web.sh

# Screenshots and images (documentation assets excluded)
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.svg


# Uploads and temporary files
uploads/
tmp/
temp/

# General backups
*.bak

# =============================================================================
# IDE & Editor
# =============================================================================

# VSCode
.vscode/

# JetBrains IDEs
.idea/

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*
# Gzip pre-compressed files (generated by vite-plugin-compression)
# All .gz files are build artifacts and should not be committed
*.gz

# Exception: Allow vendor .gz files if they exist (third-party libraries)
!frontend/**/static/**/vendor/*.gz

# Backup directory (local only)
backup-pre-optimization/
bundle-stats*.html

# Vite build temporary directory
dist/
tests/e2e/.auth/

# Playwright test results
playwright-report/
test-results/

# Build artifacts
dist/
.vite-build/
.build-cache/

# Service Worker build results
frontend/web/static/sw.min.js
frontend/web/static/sw.min.js.map
frontend/web/static/sw.min.js.gz
backend/.env.test

.claude/sessions/
# Claude Code Agent Workspace
.claude/workspace

# Claude Code Agent Workspace
.claude/workspace/
