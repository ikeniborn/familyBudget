#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."
echo ""

# Check for console.log in staged TypeScript files (exclude tests, JSDoc, DEBUG_MODE guards)
echo "1️⃣  Checking for console.log in staged files..."
CONSOLE_LOG_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.ts$' | grep -v '\.test\.ts$' | grep -v '\.spec\.ts$' | xargs grep -n 'console\.log' 2>/dev/null | grep -v '^\s*//' | grep -v '^\s*\*' | grep -v 'DEBUG_MODE.*console\.log' | grep -v 'console\.log\.bind' || true)
if [ -n "$CONSOLE_LOG_FILES" ]; then
  echo "$CONSOLE_LOG_FILES"
  echo "❌ console.log found in staged TypeScript files"
  echo "   Use debugLog() or logAPI methods instead"
  exit 1
fi
echo "✅ No console.log found"
echo ""

# Run TypeScript type checking
echo "2️⃣  Running TypeScript type check..."
npm run type-check
if [ $? -ne 0 ]; then
  echo "❌ Type check failed! Fix errors before committing."
  exit 1
fi
echo "✅ Type check passed"
echo ""

# Run unit tests (fast only, no coverage)
echo "3️⃣  Running unit tests..."
npm test -- --run --reporter=dot 2>&1 | tail -5
if [ $? -ne 0 ]; then
  echo "❌ Tests failed! Fix failing tests before committing."
  exit 1
fi
echo "✅ All tests passed"
echo ""

echo "✅ All pre-commit checks passed!"
