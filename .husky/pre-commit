#!/usr/bin/env bash

# Save git repository root
GIT_ROOT=$(git rev-parse --show-toplevel)

# Setup PATH to find npm (for VS Code and other GUI tools)
# Check common npm installation locations
if command -v npm >/dev/null 2>&1; then
  # npm already in PATH
  :
elif [ -f "$HOME/.nvm/nvm.sh" ]; then
  # Standard NVM installation
  . "$HOME/.nvm/nvm.sh"
elif [ -d "$HOME/.nvm-isolated/versions/node" ]; then
  # Isolated NVM installation (iclaude)
  export PATH="$HOME/.nvm-isolated/versions/node/$(ls -1 "$HOME/.nvm-isolated/versions/node" | tail -1)/bin:$PATH"
elif [ -f "/usr/local/bin/npm" ]; then
  # System npm
  export PATH="/usr/local/bin:$PATH"
fi

# Verify npm is available
if ! command -v npm >/dev/null 2>&1; then
  echo "❌ npm not found in PATH"
  echo "   Please ensure Node.js and npm are installed"
  echo "   Current PATH: $PATH"
  exit 1
fi

echo "🔍 Running pre-commit checks..."
echo ""

# ============================================================================
# Auto-sync package.json version with VERSION file
# ============================================================================
if git diff --cached --name-only | grep -q '^VERSION$'; then
  echo "0️⃣  VERSION file changed, syncing package.json..."

  VERSION=$(cat "$GIT_ROOT/VERSION" | tr -d '[:space:]')
  CURRENT_PKG_VERSION=$(grep -m1 '"version"' "$GIT_ROOT/package.json" | sed 's/.*"version": "\(.*\)".*/\1/')

  if [ "$VERSION" != "$CURRENT_PKG_VERSION" ]; then
    echo "   📝 Syncing package.json: $CURRENT_PKG_VERSION → $VERSION"

    # Update package.json
    sed -i.bak "s/\"version\": \"$CURRENT_PKG_VERSION\"/\"version\": \"$VERSION\"/" "$GIT_ROOT/package.json"
    rm -f "$GIT_ROOT/package.json.bak"

    # Update package-lock.json (2 locations: root .version and .packages."".version)
    # Use jq for reliable JSON manipulation
    if command -v jq >/dev/null 2>&1; then
      jq --arg v "$VERSION" '.version = $v' "$GIT_ROOT/package-lock.json" > "$GIT_ROOT/package-lock.json.tmp"
      jq --arg v "$VERSION" '.packages."".version = $v' "$GIT_ROOT/package-lock.json.tmp" > "$GIT_ROOT/package-lock.json"
      rm -f "$GIT_ROOT/package-lock.json.tmp"
    else
      echo "   ⚠️  jq not found, using fallback sed (may not update all locations)"
      # Get current version from package-lock.json
      CURRENT_LOCK_VERSION=$(grep -m1 '"version"' "$GIT_ROOT/package-lock.json" | sed 's/.*"version": "\(.*\)".*/\1/')
      sed -i.bak "s/\"version\": \"$CURRENT_LOCK_VERSION\"/\"version\": \"$VERSION\"/" "$GIT_ROOT/package-lock.json"
      rm -f "$GIT_ROOT/package-lock.json.bak"
    fi

    # Stage updated files
    git add "$GIT_ROOT/package.json" "$GIT_ROOT/package-lock.json"

    echo "   ✅ package.json and package-lock.json synced to $VERSION"
    echo "   ℹ️  Files staged: package.json, package-lock.json"
  else
    echo "   ✅ package.json already in sync with VERSION ($VERSION)"
  fi
  echo ""
fi

# Check for console.log in staged TypeScript files (exclude tests, E2E helpers, JSDoc, DEBUG_MODE guards)
echo "1️⃣  Checking for console.log in staged files..."
CONSOLE_LOG_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.ts$' | grep -v '\.test\.ts$' | grep -v '\.spec\.ts$' | grep -v 'logger\.ts$' | grep -v 'tests/e2e/' | xargs grep -n 'console\.log' 2>/dev/null | grep -v '^\s*//' | grep -v '^\s*\*' | grep -v 'DEBUG_MODE.*console\.log' | grep -v 'console\.log\.bind' || true)
if [ -n "$CONSOLE_LOG_FILES" ]; then
  echo "$CONSOLE_LOG_FILES"
  echo "❌ console.log found in staged TypeScript files"
  echo "   Use debugLog() or logAPI methods instead"
  exit 1
fi
echo "✅ No console.log found"
echo ""

# Run TypeScript type checking (only if TypeScript files changed)
CHANGED_TS_ALL=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.ts$' || true)

if [ -n "$CHANGED_TS_ALL" ]; then
  echo "2️⃣  Running TypeScript type check..."
  cd "$GIT_ROOT/frontend/web" && npm run type-check
  if [ $? -ne 0 ]; then
    echo "❌ Type check failed! Fix errors before committing."
    exit 1
  fi
  echo "✅ Type check passed"
else
  echo "2️⃣  Skipping type check (no TypeScript files changed)"
fi
echo ""

# Run unit tests (only if TypeScript source files changed, not for docs/configs)
# Skip tests if SKIP_TESTS=1 environment variable is set
CHANGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.ts$' | grep -v '\.test\.ts$' | grep -v '\.spec\.ts$' | grep -v '\.d\.ts$' | grep -v 'vite\.config\.ts$' | grep -v 'vitest\.config\.ts$' || true)

if [ -n "$CHANGED_TS_FILES" ] && [ "${SKIP_TESTS:-0}" != "1" ]; then
  echo "3️⃣  Running unit tests..."

  # Check if test script exists in package.json
  if grep -q '"test"' "$GIT_ROOT/package.json" || grep -q '"test:coverage"' "$GIT_ROOT/package.json"; then
    # Run tests from project root
    cd "$GIT_ROOT"

    # Use test:coverage if test doesn't exist
    if grep -q '"test":' "$GIT_ROOT/package.json"; then
      npm test -- --run --reporter=dot 2>&1 | tail -10
      TEST_EXIT_CODE=${PIPESTATUS[0]}  # Get exit code of npm, not tail
    else
      npm run test:coverage -- --run --reporter=dot 2>&1 | tail -10
      TEST_EXIT_CODE=${PIPESTATUS[0]}  # Get exit code of npm, not tail
    fi

    if [ $TEST_EXIT_CODE -ne 0 ]; then
      echo "❌ Tests failed! Fix failing tests before committing."
      exit 1
    fi
    echo "✅ All tests passed"
  else
    echo "⚠️  No test script found in package.json, skipping tests"
  fi
else
  if [ "${SKIP_TESTS:-0}" = "1" ]; then
    echo "3️⃣  Skipping unit tests (SKIP_TESTS=1)"
  else
    echo "3️⃣  Skipping unit tests (no source files changed)"
  fi
fi
echo ""

echo "✅ All pre-commit checks passed!"
