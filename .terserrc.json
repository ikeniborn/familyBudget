{
  "ecma": 2020,
  "module": false,
  "compress": {
    "arguments": true,
    "booleans_as_integers": true,
    "drop_console": false,
    "drop_debugger": true,
    "ecma": 2020,
    "hoist_funs": true,
    "keep_fargs": false,
    "passes": 3,
    "pure_getters": true,
    "unsafe": false,
    "unsafe_arrows": true,
    "unsafe_comps": true,
    "unsafe_Function": false,
    "unsafe_math": true,
    "unsafe_symbols": false,
    "unsafe_methods": false,
    "unsafe_proto": false,
    "unsafe_regexp": false,
    "unsafe_undefined": true
  },
  "mangle": {
    "eval": false,
    "keep_classnames": false,
    "keep_fnames": false,
    "module": false,
    "safari10": false,
    "toplevel": true,
    "reserved": ["$", "exports", "require"]
  },
  "format": {
    "comments": false,
    "ecma": 2020,
    "ascii_only": false,
    "beautify": false,
    "braces": false,
    "semicolons": true
  },
  "sourceMap": false,
  "toplevel": true
}
