{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LLM Wiki Domain Map",
  "version": "1.0.0",
  "wiki_root": ".wiki",
  "domains": [
    {
      "id": "архитектура",
      "name": "Архитектура проекта Family Budget",
      "description": "Архитектурная документация: паттерны, компоненты, операции, безопасность",
      "wiki_path": ".wiki/архитектура",
      "source_paths": [
        "docs/architecture"
      ],
      "entity_types": [
        {
          "type": "паттерн",
          "description": "Архитектурный или программный паттерн, применяемый в проекте",
          "extraction_cues": [
            "паттерн", "pattern", "стратегия", "подход", "архитектура", "Closure Table",
            "SCD", "retry", "backoff", "multi-stage", "Registry-First", "offline-first",
            "incremental", "Leader-Follower", "exponential backoff", "cache-busting"
          ],
          "min_mentions_for_page": 2,
          "wiki_subfolder": "архитектура/паттерны"
        },
        {
          "type": "компонент",
          "description": "Frontend-компонент, UI-элемент или модуль шаблонов (HTMX/Tailwind/DaisyUI)",
          "extraction_cues": [
            "компонент", "modal", "template", "шаблон", "FAB", "модалка", "responsive",
            "breakpoint", "Tailwind", "DaisyUI", "HTMX", "tab", "speed dial", "navbar",
            "таблица", "loading", "z-index", "window export", "адаптер"
          ],
          "min_mentions_for_page": 2,
          "wiki_subfolder": "архитектура/компоненты"
        },
        {
          "type": "сервис",
          "description": "Backend-сервис или FastAPI endpoint с бизнес-логикой",
          "extraction_cues": [
            "сервис", "service", "endpoint", "router", "FastAPI", "handler", "scheduler",
            "recurring plan", "fact", "budget", "article", "financial center", "cost center",
            "API", "REST", "SQLModel", "asyncpg", "Pydantic"
          ],
          "min_mentions_for_page": 2,
          "wiki_subfolder": "архитектура/сервисы"
        },
        {
          "type": "инфраструктура",
          "description": "Инфраструктурное решение: Docker, CI/CD, деплой, версионирование",
          "extraction_cues": [
            "Docker", "CI/CD", "GitHub Actions", "деплой", "deploy", "workflow", "image",
            "container", "registry", "ghcr.io", "версия", "VERSION", "Dockerfile",
            "docker-compose", "nginx", "redis", "postgresql", "build", "cache", "Vite"
          ],
          "min_mentions_for_page": 2,
          "wiki_subfolder": "архитектура/инфраструктура"
        },
        {
          "type": "безопасность",
          "description": "Механизм безопасности: аутентификация, авторизация, защита данных",
          "extraction_cues": [
            "аутентификация", "authentication", "JWT", "token", "Telegram OAuth", "WebAuthn",
            "2FA", "TOTP", "Argon2", "rate limiting", "HMAC", "PII", "logging", "hash",
            "httpOnly", "cookie", "refresh token", "biometric", "безопасность", "security"
          ],
          "min_mentions_for_page": 1,
          "wiki_subfolder": "архитектура/безопасность"
        },
        {
          "type": "интеграция",
          "description": "Механизм интеграции компонентов: WebSocket, Dexie offline, PWA, Redis",
          "extraction_cues": [
            "WebSocket", "Dexie", "IndexedDB", "offline", "PWA", "Service Worker", "Redis",
            "pub/sub", "sync", "синхронизация", "real-time", "broadcast", "BroadcastChannel",
            "multi-tab", "push notification", "Telegram bot", "webhook", "event"
          ],
          "min_mentions_for_page": 2,
          "wiki_subfolder": "архитектура/интеграции"
        }
      ],
      "tags": [
        "FastAPI", "PostgreSQL", "Docker", "Redis", "WebSocket", "PWA", "Dexie",
        "TypeScript", "Vite", "Tailwind", "DaisyUI", "HTMX", "Telegram", "JWT",
        "WebAuthn", "2FA", "Argon2", "SCD", "ClosureTable", "offline-first",
        "CI/CD", "GitHub-Actions", "semantic-versioning", "nginx", "SQLModel",
        "Alembic", "distroless", "multi-stage-build", "incremental-build",
        "cache-busting", "Service-Worker", "IndexedDB", "retry-pattern"
      ],
      "language_notes": "Документация смешанная: технические термины и названия компонентов на английском, описания и комментарии на русском. Логи и команды всегда на английском. Имена файлов и переменных — kebab-case или camelCase."
    },
    {
      "id": "бэкенд",
      "name": "Backend — FastAPI, БД, тесты",
      "description": "Внутренняя документация backend: структура приложения, миграции БД, тестирование",
      "wiki_path": ".wiki/бэкенд",
      "source_paths": [
        "backend"
      ],
      "entity_types": [
        {
          "type": "приложение",
          "description": "Структура FastAPI-приложения, роутеры, конфигурация, зависимости",
          "extraction_cues": [
            "FastAPI", "router", "endpoint", "API", "middleware", "dependency", "config",
            "Pydantic", "settings", "uvicorn", "SQLModel", "asyncpg", "main.py",
            "health check", "CORS", "JWT", "app structure"
          ],
          "min_mentions_for_page": 2,
          "wiki_subfolder": "бэкенд/приложение"
        },
        {
          "type": "миграции",
          "description": "Система миграций базы данных Alembic, паттерны схемы, операции",
          "extraction_cues": [
            "Alembic", "migration", "миграция", "alembic revision", "alembic upgrade",
            "alembic downgrade", "schema", "DDL", "SCD", "Closure Table", "baseline",
            "версионирование схемы", "upgrade head", "downgrade", "autogenerate",
            "alembic_version", "run_migrations"
          ],
          "min_mentions_for_page": 2,
          "wiki_subfolder": "бэкенд/миграции"
        },
        {
          "type": "тестирование",
          "description": "Стратегия тестирования backend: E2E, интеграционные, unit тесты",
          "extraction_cues": [
            "pytest", "test", "тест", "E2E", "integration", "fixture", "conftest",
            "AsyncClient", "auth_client", "admin_client", "test_user", "journey",
            "workflow", "asyncio", "httpx", "coverage", "assert"
          ],
          "min_mentions_for_page": 2,
          "wiki_subfolder": "бэкенд/тестирование"
        }
      ],
      "tags": [
        "FastAPI", "SQLModel", "Alembic", "PostgreSQL", "asyncpg", "pytest",
        "E2E", "JWT", "uvicorn", "Pydantic", "asyncio", "httpx"
      ],
      "language_notes": "Документация на английском и русском. Технические термины и команды — английский. Описания на русском. Файлы: snake_case Python, kebab-case документация."
    },
    {
      "id": "скрипты",
      "name": "Скрипты операций и автоматизации",
      "description": "Bash/Python скрипты: деплой, бэкап, SSL, CI, сборка, утилиты, systemd/cron",
      "wiki_path": ".wiki/скрипты",
      "source_paths": [
        "scripts"
      ],
      "entity_types": [
        {
          "type": "деплой",
          "description": "Скрипты и модули, отвечающие за развёртывание приложения на сервере",
          "extraction_cues": [
            "deploy", "deployment", "деплой", "развёртывание", "service", "container",
            "docker", "compose", "start", "stop", "cleanup", "restart", "sync",
            "PostgreSQL", "postgres", "migration", "network", "port", "health"
          ],
          "min_mentions_for_page": 2,
          "wiki_subfolder": "скрипты/деплой"
        },
        {
          "type": "бэкап",
          "description": "Скрипты резервного копирования: pg_dump, S3, ротация, мониторинг",
          "extraction_cues": [
            "backup", "бэкап", "резервн", "restore", "pg_dump", "S3", "s3",
            "retention", "rotation", "cron", "check_backup", "health", "yandex"
          ],
          "min_mentions_for_page": 2,
          "wiki_subfolder": "скрипты/бэкап"
        },
        {
          "type": "ssl",
          "description": "Управление SSL-сертификатами: certbot, Let's Encrypt, nginx, UFW",
          "extraction_cues": [
            "SSL", "ssl", "certificate", "certbot", "Let's Encrypt", "HTTPS", "nginx",
            "UFW", "firewall", "443", "renewal", "cron", "TLS"
          ],
          "min_mentions_for_page": 2,
          "wiki_subfolder": "скрипты/ssl"
        },
        {
          "type": "ci",
          "description": "Скрипты CI/CD: проверка образов, cache busting, валидация артефактов",
          "extraction_cues": [
            "CI", "ci", "IMAGE_VERSIONS", "image", "build", "artifact", "validate",
            "cache_busting", "cache-busting", "GitHub Actions", "workflow", "ghcr.io"
          ],
          "min_mentions_for_page": 2,
          "wiki_subfolder": "скрипты/ci"
        },
        {
          "type": "утилита",
          "description": "Вспомогательные скрипты: генерация ключей, иконки, исправления, диагностика",
          "extraction_cues": [
            "util", "generate", "генерация", "fix", "diagnose", "диагностика",
            "VAPID", "PWA", "icon", "npm", "import", "admin", "user", "cleanup", "dev"
          ],
          "min_mentions_for_page": 1,
          "wiki_subfolder": "скрипты/утилиты"
        },
        {
          "type": "инфраструктура-ос",
          "description": "systemd, cron, logrotate — интеграция с операционной системой",
          "extraction_cues": [
            "systemd", "service", ".service", ".timer", "cron", "crontab", "logrotate",
            "journalctl", "systemctl", "daemon", "autostart"
          ],
          "min_mentions_for_page": 1,
          "wiki_subfolder": "скрипты/инфраструктура-ос"
        }
      ],
      "tags": [
        "bash", "shell", "python", "deploy", "backup", "s3", "ssl", "certbot",
        "ci-cd", "docker", "postgres", "systemd", "cron", "nginx", "ufw"
      ],
      "language_notes": "Скрипты на bash/python, комментарии смешанные (англ./рус.). Документация в README.md на английском. Заголовки и переменные — UPPER_CASE для bash, snake_case для python."
    }
  ],
  "cross_domain_rules": {
    "description": "Правила для сущностей, встречающихся в нескольких доменах",
    "rules": []
  },
  "special_source_types": {}
}
