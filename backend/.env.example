# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/familybudget

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRY_DAYS=7

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Admin User Configuration
# Telegram ID первого администратора (получить через @userinfobot в Telegram)
# Пользователь с этим ID автоматически получает is_admin=True и is_active=True при первом входе
# Обязательная переменная для корректной работы системы после установки
ADMIN_TELEGRAM_ID=123456789

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Logging
LOG_LEVEL=INFO
