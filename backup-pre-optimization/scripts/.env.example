# Family Budget - Backup Script Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# PostgreSQL Configuration (Required)
# ============================================================================
POSTGRES_USER=familybudget
POSTGRES_DB=familybudget_db
POSTGRES_PASSWORD=your_secure_password_here

# ============================================================================
# S3 Configuration (Optional - for weekly cloud backups)
# ============================================================================

# Yandex Object Storage credentials
# Get from: https://console.cloud.yandex.com/
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# S3 bucket configuration
S3_BUCKET_NAME=familybudget-backups
S3_ENDPOINT_URL=https://storage.yandexcloud.net

# ============================================================================
# Backup Configuration (Optional - defaults shown)
# ============================================================================

# Local backup directory (default: ./backups)
# BACKUP_DIR=/var/backups/familybudget

# Log directory (default: ./backups/logs)
# LOG_DIR=/var/log/familybudget

# ============================================================================
# Notes
# ============================================================================
#
# 1. This file should NOT be committed to Git (.gitignore)
# 2. Set file permissions: chmod 600 .env
# 3. Load before running backup: set -a && source .env && set +a
# 4. S3 credentials are optional - backups work without them
# 5. Weekly S3 uploads happen only on Sundays (unless --force-s3)
#
