# Family Budget - PostgreSQL Backup Cron Job
# ============================================================================
#
# Description:
#   Daily backup at 2:00 AM with logging
#
# Installation:
#   sudo cp scripts/cron/familybudget-backup.cron /etc/cron.d/familybudget-backup
#   sudo chmod 644 /etc/cron.d/familybudget-backup
#
# Manual crontab installation (alternative):
#   crontab -e
#   # Add line: 0 2 * * * /opt/familybudget/scripts/backup.sh >> /var/log/familybudget/cron.log 2>&1
#
# Logs:
#   /var/log/familybudget/cron.log
#   /opt/familybudget/backups/logs/backup_YYYYMMDD.log
#
# ============================================================================

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

# Run daily at 2:00 AM
0 2 * * * root cd /opt/familybudget && set -a && source .env && set +a && ./scripts/backup.sh >> /var/log/familybudget/cron.log 2>&1
