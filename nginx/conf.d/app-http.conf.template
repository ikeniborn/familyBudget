# Family Budget - HTTP-Only Nginx Configuration (Initial Setup)
# This configuration is used BEFORE SSL certificate is obtained.
# Purpose: Serve HTTP traffic and ACME challenges for Let's Encrypt
# Variable: {{DOMAIN}}
# Note: Upstream backend defined in upstream.conf.template

# HTTP Server - Port 80
# Serves initial content and ACME challenges for SSL certificate acquisition
server {
    listen 80;
    listen [::]:80;
    server_name {{DOMAIN}};

    # Logging (Docker best practice: stdout/stderr)
    access_log /dev/stdout;
    error_log /dev/stderr;

    # Let's Encrypt ACME challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # PWA Manifest (served directly by nginx)
    location = /manifest.json {
        alias /usr/share/nginx/html/manifest.json;
        add_header Content-Type "application/manifest+json" always;
        add_header Cache-Control "public, max-age=3600, must-revalidate" always;  # 1 hour
        add_header Access-Control-Allow-Origin "*" always;
    }

    # Service Worker - served by FastAPI backend (v6.8.0+)
    # Reason: Avoids Docker bind mount inode issues, auto-updates after deployment
    # Backend endpoint: GET /sw.min.js (backend/app/main.py:356)
    # Nginx proxies to backend (no static file serving)

    # WebSocket endpoint - dedicated location for budget WebSocket
    location /api/v1/budget/ws {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket-specific settings
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400s;  # 24 hours for long-lived WebSocket connections
        proxy_send_timeout 86400s;

        # Disable buffering for real-time communication
        proxy_buffering off;

        # Disable access log for WebSocket (JWT token in URL - security)
        access_log off;
    }

    # Proxy all other requests to backend
    location / {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
    }
}
