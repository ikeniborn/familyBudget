# Family Budget - HTTP-Only Nginx Configuration (Initial Setup)
# This configuration is used BEFORE SSL certificate is obtained.
# Purpose: Serve HTTP traffic and ACME challenges for Let's Encrypt
# Variable: {{DOMAIN}}

# Upstream backend
upstream backend {
    server backend:8000;
    keepalive 32;
}

# HTTP Server - Port 80
# Serves initial content and ACME challenges for SSL certificate acquisition
server {
    listen 80;
    listen [::]:80;
    server_name {{DOMAIN}};

    # Logging (Docker best practice: stdout/stderr)
    access_log /dev/stdout;
    error_log /dev/stderr;

    # Let's Encrypt ACME challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # PWA Manifest (served directly by nginx)
    location = /manifest.json {
        alias /usr/share/nginx/html/manifest.json;
        add_header Content-Type "application/manifest+json" always;
        add_header Cache-Control "public, max-age=3600, must-revalidate" always;  # 1 hour
        add_header Access-Control-Allow-Origin "*" always;
    }

    # Service Worker (served directly by nginx - minified + gzip pre-compressed)
    location = /sw.js {
        alias /usr/share/nginx/html/sw.js;
        gzip_static on;
        add_header Content-Type "application/javascript; charset=utf-8" always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;  # Never cache Service Worker
        add_header Pragma "no-cache" always;
        add_header Service-Worker-Allowed "/" always;
        add_header Access-Control-Allow-Origin "*" always;
        etag on;
        if_modified_since exact;
    }

    # SSE endpoint - disable buffering for real-time events
    location /api/v1/budget/events {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE-specific settings
        proxy_buffering off;
        proxy_cache off;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 86400s;  # 24 hours for long-lived SSE connections
        chunked_transfer_encoding off;
    }

    # Proxy all other requests to backend
    location / {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
    }
}
