# Family Budget - Application Nginx Configuration Template
# This file is a template that will be processed by setup.sh
# Variables: {{DOMAIN}}

# Upstream backend
upstream backend {
    server backend:8000;
    keepalive 32;
}

# HTTP Server - Port 80
# Initially serves content and ACME challenges
# After SSL setup, redirects to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name {{DOMAIN}};

    # Logging
    access_log /var/log/nginx/{{DOMAIN}}_access.log;
    error_log /var/log/nginx/{{DOMAIN}}_error.log;

    # Let's Encrypt ACME challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Initial configuration - proxy to backend
    # This will be replaced with redirect after SSL setup
    location / {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
    }
}

