# CouchDB Notes Server Configuration
# Domain: {{NOTES_DOMAIN}}
# Generated by setup.sh - DO NOT edit manually
#
# This configuration provides HTTPS access to CouchDB for notes storage (Obsidian, etc.)
# Port 5984 is bound to localhost ONLY for security - all external access via nginx reverse proxy

upstream couchdb_backend {
    server 127.0.0.1:5984;
    keepalive 32;
}

# HTTP Server (redirect to HTTPS after SSL certificate is obtained)
server {
    listen 80;
    listen [::]:80;
    server_name {{NOTES_DOMAIN}};

    # Let's Encrypt ACME challenge (required for initial certificate)
    location /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
    }

    # Redirect all other traffic to HTTPS (COMMENTED until SSL certificate is obtained)
