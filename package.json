{
  "name": "family-budget",
  "version": "5.0.0-beta",
  "description": "Family Budget - Telegram-based personal finance management system",
  "main": "index.js",
  "scripts": {
    "build:css": "npx tailwindcss -i ./frontend/web/static/css/tailwind.input.css -o ./frontend/web/static/css/vendor/tailwind-daisyui.min.css --minify",
    "watch:css": "npx tailwindcss -i ./frontend/web/static/css/tailwind.input.css -o ./frontend/web/static/css/vendor/tailwind-daisyui.min.css --watch",
    "minify:js": "bash scripts/lib/minify.sh js",
    "minify:css": "bash scripts/lib/minify.sh css",
    "build": "npm run build:css && npm run minify:js && npm run minify:css",
    "validate:minified": "bash scripts/lib/minify.sh validate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/familyBudget.git"
  },
  "keywords": [
    "budget",
    "telegram",
    "fastapi",
    "htmx",
    "family",
    "finance"
  ],
  "author": "Family Budget Team",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/forms": "0.5.9",
    "@tailwindcss/typography": "0.5.15",
    "autoprefixer": "10.4.20",
    "cssnano": "7.0.6",
    "cssnano-cli": "1.0.5",
    "daisyui": "4.12.14",
    "postcss": "8.4.47",
    "postcss-cli": "11.0.0",
    "tailwindcss": "3.4.15",
    "terser": "5.36.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
