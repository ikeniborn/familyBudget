{
  "name": "family-budget",
  "version": "5.3.0",
  "description": "Family Budget - Telegram-based personal finance management system",
  "main": "index.js",
  "scripts": {
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "build:css": "tailwindcss -i ./frontend/web/static/css/tailwind.input.css -o ./frontend/web/static/css/vendor/tailwind-daisyui.min.css --minify",
    "watch:css": "tailwindcss -i ./frontend/web/static/css/tailwind.input.css -o ./frontend/web/static/css/vendor/tailwind-daisyui.min.css --watch",
    "bundle:legacy": "bash scripts/lib/build-bundle.sh",
    "bundle": "NODE_ENV=production rollup -c",
    "bundle:dev": "rollup -c",
    "bundle:watch": "rollup -c -w",
    "minify:js": "bash scripts/lib/minify.sh js",
    "minify:css": "bash scripts/lib/minify.sh css",
    "precompress": "bash scripts/precompress-assets.sh",
    "build:prod": "npm run build:css && npm run bundle && npm run precompress",
    "build": "npm run type-check && npm run build:prod",
    "watch": "concurrently \"npm run bundle:watch\" \"npm run watch:css\"",
    "analyze": "NODE_ENV=production ANALYZE=true rollup -c",
    "validate:minified": "bash scripts/lib/minify.sh validate",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/familyBudget.git"
  },
  "keywords": [
    "budget",
    "telegram",
    "fastapi",
    "htmx",
    "family",
    "finance"
  ],
  "author": "Family Budget Team",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tailwindcss/forms": "0.5.9",
    "@tailwindcss/typography": "0.5.15",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^22.19.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "10.4.20",
    "concurrently": "^8.2.2",
    "cssnano": "7.0.6",
    "daisyui": "4.12.14",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.0.11",
    "husky": "^9.1.7",
    "msw": "^2.12.7",
    "postcss": "8.4.47",
    "postcss-cli": "11.0.0",
    "rollup": "^4.55.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "tailwindcss": "3.4.15",
    "terser": "5.36.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
