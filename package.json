{
  "name": "family-budget",
  "version": "0.8.45",
  "description": "Family Budget - Telegram-based personal finance management system",
  "main": "index.js",
  "scripts": {
    "type-check": "tsc --noEmit -p config/tsconfig.json",
    "lint": "eslint . --max-warnings 5000",
    "build:tailwind": "tailwindcss -c config/tailwind.config.js -i ./frontend/web/static/css/tailwind.input.css -o ./frontend/web/static/css/tailwind-daisyui.css",
    "minify:tailwind": "postcss --config config/postcss.config.js frontend/web/static/css/tailwind-daisyui.css -u cssnano -o frontend/web/static/css/tailwind-daisyui.min.css",
    "minify:custom-css": "postcss --config config/postcss.config.js frontend/web/static/css/custom.css -u cssnano -o frontend/web/static/css/custom.min.css",
    "minify:overrides": "postcss --config config/postcss.config.js frontend/web/static/css/daisyui-overrides.css -u cssnano -o frontend/web/static/css/daisyui-overrides.min.css",
    "minify:choices": "postcss --config config/postcss.config.js frontend/web/static/css/choices-tailwind.css -u cssnano -o frontend/web/static/css/choices-tailwind.min.css",
    "minify:vendor-css": "postcss --config config/postcss.config.js frontend/web/static/css/vendor/choices.css -u cssnano -o frontend/web/static/css/vendor/choices.min.css",
    "minify:lists": "postcss --config config/postcss.config.js frontend/web/static/css/lists.css -u cssnano -o frontend/web/static/css/lists.min.css",
    "minify:calendar-widget": "postcss --config config/postcss.config.js frontend/web/static/css/calendar-widget.css -u cssnano -o frontend/web/static/css/calendar-widget.min.css",
    "minify:z-index": "postcss --config config/postcss.config.js frontend/web/static/css/z-index-variables.css -u cssnano -o frontend/web/static/css/z-index-variables.min.css",
    "minify:plan": "postcss --config config/postcss.config.js frontend/web/static/css/plan.css -u cssnano -o frontend/web/static/css/plan.min.css",
    "minify:vendor-js": "node scripts/minify-vendor.js",
    "build:css": "npm run build:tailwind && npm run minify:tailwind && npm run minify:overrides && npm run minify:custom-css && npm run minify:choices && npm run minify:lists && npm run minify:calendar-widget && npm run minify:z-index && npm run minify:vendor-css && npm run minify:plan",
    "build:vendor": "npm run minify:vendor-css && npm run minify:vendor-js",
    "bundle": "node build-all.js",
    "build:prod": "npm run build:css && npm run build:vendor && npm run bundle",
    "build": "npm run type-check && npm run build:prod",
    "test:coverage": "vitest run --config config/vitest.config.ts --coverage",
    "test:e2e": "playwright test --config=config/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=config/playwright.config.ts --ui",
    "test:e2e:headed": "playwright test --config=config/playwright.config.ts --headed",
    "test:e2e:debug": "playwright test --config=config/playwright.config.ts --debug",
    "test:e2e:chromium": "playwright test --config=config/playwright.config.ts --project=chromium",
    "test:e2e:full": "playwright test --config=config/playwright.config.ts --project=chromium --project=firefox --project=webkit --project='Mobile Chrome' --project='Mobile Safari'",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen https://fbd.ikeniborn.ru --load-storage=tests/e2e/.auth/user.json",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/familyBudget.git"
  },
  "keywords": [
    "budget",
    "telegram",
    "fastapi",
    "htmx",
    "family",
    "finance"
  ],
  "author": "Family Budget Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "autoprefixer": "10.6.0",
    "baseline-browser-mapping": "^2.9.12",
    "concurrently": "^10.0.5",
    "cssnano": "9.0.4",
    "daisyui": "5.7.37",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "jsqr": "^1.4.0",
    "msw": "^2.15.0",
    "postcss": "^8.5.12",
    "postcss-cli": "12.0.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
