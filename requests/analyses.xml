<?xml version="1.0" encoding="UTF-8"?>
<analysis>
  <context>
    <requirement>Удалить функционал раздела продуктов из приложения Family Budget</requirement>
    <url>http://localhost:5173/products</url>
    <architecture>
      <frontend>SvelteKit с TypeScript</frontend>
      <backend>FastAPI с SQLAlchemy</backend>
      <database>PostgreSQL</database>
      <infrastructure>Docker Compose</infrastructure>
    </architecture>
  </context>

  <components_to_remove>
    <frontend>
      <routes>
        <route>/frontend-svelte/src/routes/(protected)/products/+page.svelte</route>
      </routes>
      <components>
        <component>/frontend-svelte/src/lib/components/products/ProductForm.svelte</component>
        <component>/frontend-svelte/src/lib/components/products/ProductList.svelte</component>
        <component>/frontend-svelte/src/lib/components/products/ProductAnalytics.svelte</component>
        <component>/frontend-svelte/src/lib/components/products/ProductImport.svelte</component>
        <component>/frontend-svelte/src/lib/components/products/ProductNomenclatureLink.svelte</component>
        <component>/frontend-svelte/src/lib/components/products/index.ts</component>
      </components>
      <services>
        <service>/frontend-svelte/src/lib/services/product.service.ts</service>
      </services>
      <tests>
        <test>/frontend-svelte/src/lib/components/products/__tests__/products-icon-fix.test.ts</test>
        <test>/frontend-svelte/tests/product-analytics-field-mapping.test.ts</test>
      </tests>
    </frontend>

    <backend>
      <endpoints>
        <endpoint>/backend-fastapi/app/api/v1/endpoints/products.py</endpoint>
      </endpoints>
      <models>
        <model>/backend-fastapi/app/models/product.py</model>
        <model>/backend-fastapi/app/models/product_price.py</model>
        <model>/backend-fastapi/app/models/product_nomenclature.py</model>
