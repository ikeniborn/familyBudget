      <schemas>
        <schema>/backend-fastapi/app/schemas/product.py</schema>
      </schemas>
      <tests>
        <test>/backend-fastapi/tests/integration/test_products_page_500_fix.py</test>
      </tests>
    </backend>

    <database>
      <tables>
        <table>t_d_product</table>
        <table>t_f_product_price</table>
        <table>t_f_product_nomenclature_link</table>
      </tables>
    </database>
  </components_to_remove>

  <dependencies_to_check>
    <navigation>Удалить ссылку на /products из навигации</navigation>
    <imports>Проверить и удалить импорты product-related модулей</imports>
    <router>Удалить маршруты API для products</router>
    <reports>Проверить отчеты и дашборды на использование данных о продуктах</reports>
    <documentation>Обновить документацию</documentation>
  </dependencies_to_check>

  <risks>
    <risk priority="high">Возможные ссылки на продукты в отчетах и аналитике</risk>
    <risk priority="medium">База данных может содержать связанные данные</risk>
    <risk priority="low">Кэшированные данные в Redis</risk>
  </risks>

  <testing_required>
    <test>Проверить доступность всех страниц после удаления</test>
    <test>Проверить работу навигации</test>
    <test>Проверить API endpoints на отсутствие ошибок</test>
    <test>Проверить отчеты и дашборды</test>
    <test>Выполнить интеграционные тесты</test>
  </testing_required>
</analysis>