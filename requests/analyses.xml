  <recommendations>
    <recommendation priority="high">
      <action>Удалить все console.log вызовы, используемые для отладки</action>
      <reason>Отладочные логи не должны присутствовать в production коде</reason>
    </recommendation>

    <recommendation priority="high">
      <action>Удалить логирование в isAdmin derived store</action>
      <reason>Этот store вызывается очень часто и генерирует большое количество логов</reason>
    </recommendation>

    <recommendation priority="medium">
      <action>Оставить только критические console.error для реальных ошибок</action>
      <reason>Важные ошибки должны логироваться для диагностики проблем</reason>
    </recommendation>

    <recommendation priority="low">
      <action>Использовать условное логирование через DEBUG флаг если необходимо</action>
      <reason>Позволит включать отладку при необходимости без изменения кода</reason>
