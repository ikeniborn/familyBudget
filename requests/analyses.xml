<?xml version="1.0" encoding="UTF-8"?>
<analysis>
    <context>
        <requirement>Ограничить доступ к справочникам и настройкам для пользователей без роли администратора</requirement>
        <scope>
            <item>Скрыть пункт меню "Справочники" в боковой навигации</item>
            <item>Скрыть иконку настроек (шестеренку) в хедере</item>
            <item>Запретить доступ к страницам настроек для обычных пользователей</item>
        </scope>
    </context>

    <current_state>
        <auth_system>
            <role_model>role: 'admin' | 'user'</role_model>
            <store>auth.store.ts с поддержкой ролей</store>
            <derived_store>isAdmin для проверки администратора</derived_store>
        </auth_system>

        <navigation_components>
            <layout_component>
                <file>Layout.svelte</file>
                <issues>
                    <issue>Пункт "Справочники" в меню отображается всем пользователям (строка 41-44)</issue>
                    <issue>Иконка настроек в хедере видна всем (строка 220-225)</issue>
                    <issue>Отсутствует проверка роли при формировании navItems</issue>
                </issues>
            </layout_component>

            <settings_navigation>
                <file>SettingsNavigation.svelte</file>
                <partial_implementation>Системные настройки скрыты для не-админов (строка 172-174)</partial_implementation>
                <issues>
                    <issue>Разделы "Справочники" и "Каталоги" доступны всем</issue>
                </issues>
            </settings_navigation>
        </navigation_components>
    </current_state>

    <required_changes>
        <change priority="1">
            <component>Layout.svelte</component>
            <action>Добавить условное отображение пункта "Справочники" только для администраторов</action>
            <location>Строка 48, формирование navItems</location>
        </change>

        <change priority="2">
            <component>Layout.svelte</component>
            <action>Скрыть иконку Settings в хедере для обычных пользователей</action>
            <location>Строки 217-225</location>
        </change>

        <change priority="3">
            <component>SettingsNavigation.svelte</component>
            <action>Показывать все категории настроек только администраторам</action>
            <location>Строки 172-174</location>
        </change>

        <change priority="4">
            <component>Settings pages layout</component>
            <action>Добавить защиту на уровне layout для страниц настроек</action>
            <location>Создать или модифицировать +layout.svelte в /settings/</location>
        </change>
    </required_changes>

    <technical_approach>
        <step>Импортировать isAdmin store в Layout.svelte</step>
        <step>Использовать реактивное условие для фильтрации navItems</step>
        <step>Обернуть иконку Settings в условный блок {#if $isAdmin}</step>
        <step>В SettingsNavigation скрывать все категории для не-админов</step>
        <step>Добавить серверную проверку роли в +page.server.ts</step>
    </technical_approach>
</analysis>