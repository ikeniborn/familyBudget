          <content><![CDATA[
  describe('Simplified UI (No Expansion)', () => {
    it('should maintain core functionality without expansion features', () => {
      // Test that toasts still work without expansion
      const id1 = toastStore.success('Test 1');
      const id2 = toastStore.error('Test 2');

      const state = get(toastStore);
      expect(state.toasts).toHaveLength(2);

      // Verify basic functionality
      toastStore.remove(id1);
      const stateAfterRemoval = get(toastStore);
      expect(stateAfterRemoval.toasts).toHaveLength(1);
      expect(stateAfterRemoval.toasts[0].id).toBe(id2);
    });
  });
          ]]></content>
