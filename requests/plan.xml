<?xml version="1.0" encoding="UTF-8"?>
<implementation_plan>
    <summary>
        Fix user editing form issues in UserModal.svelte to enable proper editing functionality
        for user_name and user_email fields, and make username read-only for existing users.
    </summary>

    <current_issues>
        <issue id="1">
            <description>Input component prop mismatch</description>
            <details>
                UserModal.svelte uses `error={errors.field_name}` but Input component expects `hasError` boolean prop.
                This causes form fields to not behave properly for error states.
            </details>
            <affected_lines>139, 154, 167, 181</affected_lines>
        </issue>

        <issue id="2">
            <description>Username field should be readonly when editing</description>
            <details>
                The username (Логин) field should be read-only when editing existing users to prevent
                changes to the login identifier, but currently has no readonly logic.
            </details>
            <affected_lines>163-168</affected_lines>
        </issue>
    </current_issues>

    <requirements>
        <requirement id="1">Enable editing for user_name (Имя пользователя) field</requirement>
        <requirement id="2">Enable editing for user_email (Email) field</requirement>
        <requirement id="3">Make username (Логин) field read-only when editing existing user</requirement>
        <requirement id="4">Fix Input component prop usage to use correct hasError boolean prop</requirement>
    </requirements>

    <implementation_steps>
        <step id="1">
            <title>Fix Input component prop usage</title>
            <description>Replace `error` prop with `hasError` boolean prop for all Input components</description>
            <files>
                <file>frontend-svelte/src/lib/components/modals/UserModal.svelte</file>
            </files>
            <changes>
                <change line="139">
                    <from>error={errors.user_name}</from>
                    <to>hasError={!!errors.user_name}</to>
                </change>
                <change line="154">
                    <from>error={errors.user_email}</from>
                    <to>hasError={!!errors.user_email}</to>
                </change>
                <change line="167">
                    <from>error={errors.username}</from>
                    <to>hasError={!!errors.username}</to>
                </change>
                <change line="181">
                    <from>error={errors.password}</from>
                    <to>hasError={!!errors.password}</to>
                </change>
            </changes>
        </step>

        <step id="2">
            <title>Add error message display elements</title>
            <description>Since we're changing from error prop to hasError, we need to add separate error message elements</description>
            <files>
                <file>frontend-svelte/src/lib/components/modals/UserModal.svelte</file>
            </files>
            <changes>
                <change line="after_141">
                    <add>
                        {#if errors.user_name}
                          <div class="text-sm text-red-600">{errors.user_name}</div>
                        {/if}
                    </add>
                </change>
                <change line="after_156">
                    <add>
                        {#if errors.user_email}
                          <div class="text-sm text-red-600">{errors.user_email}</div>
                        {/if}
                    </add>
                </change>
                <change line="after_169">
                    <add>
                        {#if errors.username}
                          <div class="text-sm text-red-600">{errors.username}</div>
                        {/if}
                    </add>
                </change>
                <change line="after_184">
                    <add>
                        {#if errors.password}
                          <div class="text-sm text-red-600">{errors.password}</div>
                        {/if}
                    </add>
                </change>
            </changes>
        </step>

        <step id="3">
            <title>Make username field readonly when editing</title>
            <description>Add readonly prop to username Input when in editing mode</description>
            <files>
                <file>frontend-svelte/src/lib/components/modals/UserModal.svelte</file>
            </files>
            <changes>
                <change line="163-168">
                    <from>
                        <Input
                          id="username"
                          bind:value={formData.username}
                          placeholder="Введите логин"
                          error={errors.username}
                        />
                    </from>
                    <to>
                        <Input
                          id="username"
                          bind:value={formData.username}
                          placeholder="Введите логин"
                          hasError={!!errors.username}
                          readonly={isEditing}
                        />
                    </to>
                </change>
            </changes>
        </step>

        <step id="4">
            <title>Update username label to indicate readonly state</title>
            <description>Modify the username label to indicate when it's readonly</description>
            <files>
                <file>frontend-svelte/src/lib/components/modals/UserModal.svelte</file>
            </files>
            <changes>
                <change line="160-162">
                    <from>
                        <label for="username" class="block text-sm font-medium text-gray-700">
                          Логин
                        </label>
                    </from>
                    <to>
                        <label for="username" class="block text-sm font-medium text-gray-700">
                          Логин {isEditing ? '(только для чтения)' : ''}
                        </label>
                    </to>
                </change>
            </changes>
        </step>

        <step id="5">
            <title>Ensure user_name and user_email remain editable</title>
            <description>Verify that user_name and user_email fields don't have unnecessary restrictions</description>
            <files>
                <file>frontend-svelte/src/lib/components/modals/UserModal.svelte</file>
            </files>
            <verification>
                <check>user_name Input component should not have disabled or readonly props</check>
                <check>user_email Input component should not have disabled or readonly props</check>
                <check>Both fields should bind properly to formData values</check>
            </verification>
        </step>
    </implementation_steps>

    <testing_requirements>
        <test id="1">
            <description>Test form field editability</description>
            <scenarios>
                <scenario>Create new user: all fields should be editable</scenario>
                <scenario>Edit existing user: user_name and user_email should be editable</scenario>
                <scenario>Edit existing user: username should be readonly</scenario>
                <scenario>Password field should be optional when editing</scenario>
            </scenarios>
        </test>

        <test id="2">
            <description>Test error handling</description>
            <scenarios>
                <scenario>Verify hasError prop correctly shows error states</scenario>
                <scenario>Verify error messages display correctly below inputs</scenario>
                <scenario>Verify validation works for all field types</scenario>
            </scenarios>
        </test>

        <test id="3">
            <description>Test form submission</description>
            <scenarios>
                <scenario>Create user with valid data should succeed</scenario>
                <scenario>Update user with changed user_name/user_email should succeed</scenario>
                <scenario>Update user without changing username should succeed</scenario>
            </scenarios>
        </test>
    </testing_requirements>

    <validation_criteria>
        <criteria>
            <item>user_name field is editable in both create and edit modes</item>
            <item>user_email field is editable in both create and edit modes</item>
            <item>username field is editable in create mode but readonly in edit mode</item>
            <item>All Input components use hasError prop instead of error prop</item>
            <item>Error messages display correctly below each input field</item>
            <item>Form validation works correctly for all scenarios</item>
            <item>Form submission works for both create and update operations</item>
        </criteria>
    </validation_criteria>

    <files_affected>
        <file>
            <path>frontend-svelte/src/lib/components/modals/UserModal.svelte</path>
            <change_type>modification</change_type>
            <estimated_lines_changed>12</estimated_lines_changed>
        </file>
    </files_affected>

    <dependencies>
        <dependency>
            <component>Input component (ui/Input.svelte)</component>
            <requirement>Must support hasError, readonly, and other props correctly</requirement>
        </dependency>
        <dependency>
            <component>Modal component (ui/Modal.svelte)</component>
            <requirement>Must handle form submission and events properly</requirement>
        </dependency>
    </dependencies>

    <risk_assessment>
        <risk level="low">
            <description>Changes are localized to UserModal component and don't affect other parts of the system</description>
        </risk>
        <risk level="low">
            <description>Input component prop changes are compatible and well-defined</description>
        </risk>
    </risk_assessment>
</implementation_plan>