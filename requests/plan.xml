<?xml version="1.0" encoding="UTF-8"?>
<plan>
  <objective>Fix 500 error on products page caused by non-existent Barcode icon import</objective>

  <tasks>
    <task id="1" priority="critical">
      <action>Fix ProductList.svelte component</action>
      <details>
        <file>/frontend-svelte/src/lib/components/products/ProductList.svelte</file>
        <change>
          <from>Barcode as BarcodeIcon</from>
          <to>ScanLine as BarcodeIcon</to>
          <line>14</line>
        </change>
      </details>
    </task>

    <task id="2" priority="critical">
      <action>Fix ProductForm.svelte component</action>
      <details>
        <file>/frontend-svelte/src/lib/components/products/ProductForm.svelte</file>
        <changes>
          <change>
            <from>Barcode</from>
            <to>ScanLine</to>
            <line>5</line>
          </change>
          <change>
            <from>&lt;Barcode class="h-5 w-5" /&gt;</from>
            <to>&lt;ScanLine class="h-5 w-5" /&gt;</to>
            <line>225</line>
          </change>
        </changes>
      </details>
    </task>

    <task id="3" priority="high">
      <action>Verify the fix</action>
      <steps>
        <step>Check that the dev server reloads without errors</step>
        <step>Navigate to /products page</step>
        <step>Ensure page loads correctly</step>
        <step>Test product creation and editing functionality</step>
      </steps>
    </task>

    <task id="4" priority="medium">
      <action>Create tests for the fixed functionality</action>
      <details>
        <test_file>/tests/frontend/products-icon-fix.test.ts</test_file>
        <coverage>
          <item>Test that ProductList renders without errors</item>
          <item>Test that ProductForm renders without errors</item>
          <item>Verify ScanLine icon is properly imported and rendered</item>
        </coverage>
      </details>
    </task>

    <task id="5" priority="medium">
      <action>Update documentation</action>
      <files>
        <file>/docs/api/products-barcode-icon-fix.md</file>
        <file>CLAUDE.md - add note about the fix</file>
      </files>
    </task>

    <task id="6" priority="low">
      <action>Commit changes with descriptive message</action>
      <commit_message>fix: Replace non-existent Barcode icon with ScanLine in products components</commit_message>
    </task>
  </tasks>

  <expected_result>
    <item>Products page loads without 500 error</item>
    <item>All product functionality works correctly</item>
    <item>No console errors related to icon imports</item>
  </expected_result>
</plan>