<?xml version="1.0" encoding="UTF-8"?>
<plan>
    <title>План реализации справочника статей (Articles)</title>
    <project>Family Budget Application</project>
    <description>
        Реализация справочника статей для категоризации номенклатур с поддержкой multi-tenancy и shared reference data
    </description>

    <phases>
        <phase number="1">
            <name>Backend - Модели и схемы</name>
            <tasks>
                <task>
                    <file>/backend-fastapi/app/models/article.py</file>
                    <action>Создать модель Article с полями: id, code, name, description, is_active, user_id, created_by, managed_by</action>
                    <details>
                        - Таблица t_d_article
                        - Поддержка shared records (user_id = NULL)
                        - Relationships с User и Nomenclature
                        - Global unique constraint на code
                    </details>
                </task>
                <task>
                    <file>/backend-fastapi/app/models/nomenclature.py</file>
                    <action>Обновить модель Nomenclature - добавить article_id как внешний ключ</action>
                    <details>
                        - Добавить поле article_id с ForeignKey на t_d_article
                        - Добавить relationship article
                        - Обновить метод to_dict()
                    </details>
                </task>
                <task>
                    <file>/backend-fastapi/app/schemas/article.py</file>
                    <action>Создать Pydantic схемы для Article</action>
                    <details>
                        - ArticleBase, ArticleCreate, ArticleUpdate
                        - ArticleInDB, ArticlePublic
                        - Поддержка is_shared и is_editable флагов
                    </details>
                </task>
            </tasks>
        </phase>

        <phase number="2">
            <name>Database - Миграции</name>
            <tasks>
                <task>
                    <file>/backend-fastapi/alembic/versions/[timestamp]_add_article_table.py</file>
                    <action>Создать миграцию Alembic</action>
                    <details>
                        - Создать таблицу t_d_article
                        - Добавить article_id в t_d_nomenclature
                        - Создать индексы и foreign keys
                        - Вставить начальные shared статьи (HOUSEHOLD, TRANSPORT, FOOD, etc.)
                    </details>
                </task>
            </tasks>
        </phase>

        <phase number="3">
            <name>Backend - API Endpoints</name>
            <tasks>
                <task>
                    <file>/backend-fastapi/app/api/v1/endpoints/articles.py</file>
                    <action>Создать CRUD endpoints для articles</action>
                    <details>
                        - GET /articles/ - список статей
                        - GET /articles/{id} - получить статью
                        - POST /articles/ - создать статью (admin для shared)
                        - PUT /articles/{id} - обновить статью
                        - DELETE /articles/{id} - удалить статью
                        - POST /articles/bulk-delete - массовое удаление
                    </details>
                </task>
                <task>
                    <file>/backend-fastapi/app/api/v1/router.py</file>
                    <action>Подключить articles router</action>
                </task>
                <task>
                    <file>/backend-fastapi/app/api/v1/endpoints/nomenclatures.py</file>
                    <action>Обновить endpoints номенклатур для поддержки article_id</action>
                </task>
            </tasks>
        </phase>

        <phase number="4">
            <name>Frontend - TypeScript типы и сервисы</name>
            <tasks>
                <task>
                    <file>/frontend-svelte/src/lib/types/index.ts</file>
                    <action>Добавить типы Article и AdminArticle</action>
                    <details>
                        - Интерфейс Article с полями API
                        - Обновить интерфейс Nomenclature с article_id
                    </details>
                </task>
                <task>
                    <file>/frontend-svelte/src/lib/services/articles.service.ts</file>
                    <action>Создать сервис для работы с articles API</action>
                    <details>
                        - CRUD методы
                        - Статистика статей
                        - Обработка ошибок
                    </details>
                </task>
            </tasks>
        </phase>

        <phase number="5">
            <name>Frontend - UI страницы</name>
            <tasks>
                <task>
                    <file>/frontend-svelte/src/routes/(protected)/settings/articles/+page.svelte</file>
                    <action>Создать страницу управления статьями</action>
                    <details>
                        - Таблица статей с фильтрацией
                        - Модальные окна создания/редактирования
                        - Статистические карточки
                        - Admin-only доступ для shared статей
                    </details>
                </task>
                <task>
                    <file>/frontend-svelte/src/routes/(protected)/settings/nomenclatures/+page.svelte</file>
                    <action>Обновить страницу номенклатур</action>
                    <details>
                        - Добавить выбор статьи в форму
                        - Отображение связанной статьи
                        - Загрузка списка статей
                    </details>
                </task>
                <task>
                    <file>/frontend-svelte/src/lib/components/common/Header.svelte</file>
                    <action>Добавить пункт меню для статей</action>
                </task>
            </tasks>
        </phase>

        <phase number="6">
            <name>Testing - Backend</name>
            <tasks>
                <task>
                    <file>/tests/backend/test_articles_api.py</file>
                    <action>Создать тесты для articles API</action>
                    <details>
                        - CRUD операции
                        - Проверка прав доступа (admin/user)
                        - Data isolation
                        - Shared vs user-specific статьи
                    </details>
                </task>
                <task>
                    <file>/tests/backend/test_nomenclatures_api.py</file>
                    <action>Обновить тесты номенклатур</action>
                    <details>
                        - Тесты связи с article_id
                        - Валидация внешнего ключа
                    </details>
                </task>
            </tasks>
        </phase>

        <phase number="7">
            <name>Testing - Frontend</name>
            <tasks>
                <task>
                    <file>/tests/frontend/articles.test.ts</file>
                    <action>Создать тесты для UI статей</action>
                    <details>
                        - Рендеринг компонентов
                        - CRUD операции
                        - Модальные окна
                        - Обработка ошибок
                    </details>
                </task>
                <task>
                    <file>/tests/frontend/nomenclatures.test.ts</file>
                    <action>Обновить тесты номенклатур</action>
                    <details>
                        - Тесты выбора статьи
                        - Валидация формы
                    </details>
                </task>
            </tasks>
        </phase>

        <phase number="8">
            <name>Documentation</name>
            <tasks>
                <task>
                    <file>/docs/api/endpoints.md</file>
                    <action>Документировать articles endpoints</action>
                </task>
                <task>
                    <file>/docs/architecture/adr-007-articles-module.md</file>
                    <action>Создать ADR для архитектурного решения</action>
                </task>
                <task>
                    <file>/README.md</file>
                    <action>Обновить README с информацией о статьях</action>
                </task>
                <task>
                    <file>/CLAUDE.md</file>
                    <action>Обновить инструкции с новым функционалом</action>
                </task>
            </tasks>
        </phase>
    </phases>

    <implementation_order>
        <step number="1">Создать модель Article и схемы</step>
        <step number="2">Обновить модель Nomenclature с article_id</step>
        <step number="3">Создать и выполнить миграцию БД</step>
        <step number="4">Реализовать API endpoints для articles</step>
        <step number="5">Обновить API nomenclatures для поддержки article_id</step>
        <step number="6">Создать TypeScript типы и сервис</step>
        <step number="7">Реализовать UI страницу управления статьями</step>
        <step number="8">Обновить UI номенклатур для выбора статьи</step>
        <step number="9">Написать backend тесты</step>
        <step number="10">Написать frontend тесты</step>
        <step number="11">Обновить документацию</step>
        <step number="12">Сделать финальный коммит</step>
    </implementation_order>

    <technical_details>
        <database>
            <table name="t_d_article">
                <columns>
                    <column>article_id INTEGER PRIMARY KEY</column>
                    <column>article_code VARCHAR(50) UNIQUE NOT NULL</column>
                    <column>article_name VARCHAR NOT NULL</column>
                    <column>description VARCHAR(500)</column>
                    <column>is_active BOOLEAN DEFAULT TRUE</column>
                    <column>user_id INTEGER NULL (для shared)</column>
                    <column>created_by INTEGER FK t_d_user</column>
                    <column>managed_by INTEGER FK t_d_user</column>
                    <column>created_at TIMESTAMP</column>
                    <column>updated_at TIMESTAMP</column>
                </columns>
            </table>
            <foreign_key>
                <from>t_d_nomenclature.article_id</from>
                <to>t_d_article.article_id</to>
            </foreign_key>
        </database>

        <api_security>
            <rule>Shared статьи (user_id=NULL) создают/редактируют только админы</rule>
            <rule>User статьи видны только владельцу и админам</rule>
            <rule>Все запросы фильтруются по user_id для изоляции данных</rule>
        </api_security>

        <initial_data>
            <article code="HOUSEHOLD" name="Домашние расходы"/>
            <article code="TRANSPORT" name="Транспорт"/>
            <article code="FOOD" name="Питание"/>
            <article code="UTILITIES" name="Коммунальные услуги"/>
            <article code="ENTERTAINMENT" name="Развлечения"/>
            <article code="HEALTHCARE" name="Здравоохранение"/>
            <article code="EDUCATION" name="Образование"/>
            <article code="INCOME_SALARY" name="Зарплата"/>
            <article code="INCOME_BUSINESS" name="Бизнес"/>
            <article code="INCOME_INVESTMENT" name="Инвестиции"/>
        </initial_data>
    </technical_details>
</plan>