<dashboard_fix_plan>
  <issue>
    <title>Dashboard 500 Errors - Database Schema Mismatch</title>
    <description>Dashboard page returns HTTP 500 errors due to missing database columns</description>
    <error_message>column t_d_nomenclature.nomenclature_code does not exist</error_message>
    <affected_endpoints>
      <endpoint>/api/reports/dashboard-data</endpoint>
      <endpoint>/api/nomenclatures/</endpoint>
      <endpoint>/api/periods/</endpoint>
    </affected_endpoints>
  </issue>

  <root_causes>
    <cause id="1">
      <description>Pending migration not applied</description>
      <migration_id>5ef4678b70a0</migration_id>
      <current_migration>86027abaa82e</current_migration>
    </cause>
    <cause id="2">
      <description>Missing columns in database tables</description>
      <tables>
        <table name="t_d_nomenclature">
          <missing_columns>nomenclature_code, description, created_by, managed_by</missing_columns>
        </table>
        <table name="t_d_period">
          <missing_columns>period_code, created_by, managed_by</missing_columns>
        </table>
        <table name="t_d_financial_center">
          <missing_columns>financial_center_code, description, created_by, managed_by</missing_columns>
        </table>
        <table name="t_d_cost_center">
          <missing_columns>cost_center_code, description, created_by, managed_by</missing_columns>
        </table>
      </tables>
    </cause>
  </root_causes>

  <implementation_phases>
    <phase number="1">
      <name>Database Backup</name>
      <steps>
        <step>Create full database backup</step>
        <step>Verify backup integrity</step>
      </steps>
    </phase>

    <phase number="2">
      <name>Apply Pending Migration</name>
      <steps>
        <step>Check current migration status</step>
        <step>Apply migration 5ef4678b70a0</step>
        <step>Verify nomenclature, financial_center, cost_center tables updated</step>
      </steps>
    </phase>

    <phase number="3">
      <name>Create Period Table Migration</name>
      <steps>
        <step>Generate new migration for t_d_period table</step>
        <step>Add missing columns: period_code, created_by, managed_by</step>
        <step>Apply the new migration</step>
      </steps>
    </phase>

    <phase number="4">
      <name>Validation and Testing</name>
      <steps>
        <step>Verify all columns exist in database</step>
        <step>Test dashboard API endpoints</step>
        <step>Validate frontend dashboard functionality</step>
        <step>Run full test suite</step>
      </steps>
    </phase>

    <phase number="5">
      <name>Documentation Update</name>
      <steps>
        <step>Update migration documentation</step>
        <step>Document schema changes</step>
        <step>Update CLAUDE.md if needed</step>
      </steps>
    </phase>
  </implementation_phases>

  <rollback_plan>
    <step>Stop application services</step>
    <step>Restore database from backup</step>
    <step>Revert code changes if any</step>
    <step>Restart services</step>
    <step>Verify system functionality</step>
  </rollback_plan>

  <success_criteria>
    <criterion>Dashboard loads without 500 errors</criterion>
    <criterion>All API endpoints return 200/201 status codes</criterion>
    <criterion>Database schema matches SQLAlchemy models</criterion>
