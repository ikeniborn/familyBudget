<?xml version="1.0" encoding="UTF-8"?>
<plan>
    <title>Fix Financial Center Creation Error</title>
    <issue>
        <description>[object Object] error when creating financial centers at /settings/financial-centers</description>
        <root_cause>Data contract mismatch between frontend and backend</root_cause>
        <impact>Users cannot create financial centers</impact>
    </issue>

    <analysis>
        <problem number="1">
            <type>Primary</type>
            <description>Frontend sends 'financial_center_name' but backend expects 'name'</description>
            <location>frontend-svelte/src/routes/(protected)/settings/financial-centers/+page.svelte:143-147</location>
        </problem>
        <problem number="2">
            <type>Secondary</type>
            <description>Error handling doesn't properly extract FastAPI validation error messages</description>
            <location>frontend-svelte/src/routes/(protected)/settings/financial-centers/+page.svelte:174-188</location>
        </problem>
    </analysis>

    <solution>
        <step number="1">
            <action>Fix data contract mismatch in create request</action>
            <file>frontend-svelte/src/routes/(protected)/settings/financial-centers/+page.svelte</file>
            <change>
                <from>financial_center_name: formData.name</from>
                <to>name: formData.name</to>
            </change>
            <change>
                <from>user_id: 1</from>
                <to>Remove user_id field (backend auto-assigns)</to>
            </change>
        </step>

        <step number="2">
            <action>Fix data contract mismatch in update request</action>
            <file>frontend-svelte/src/routes/(protected)/settings/financial-centers/+page.svelte</file>
            <change>
                <from>financial_center_name: formData.name</from>
                <to>name: formData.name</to>
            </change>
        </step>

        <step number="3">
            <action>Improve error handling for validation errors</action>
            <file>frontend-svelte/src/routes/(protected)/settings/financial-centers/+page.svelte</file>
            <change>
                <description>Add proper handling for FastAPI 422 validation errors</description>
                <details>Extract field errors from detail array and format as readable messages</details>
            </change>
        </step>

        <step number="4">
            <action>Test the fixes</action>
            <tests>
                <test>Create financial center with valid data</test>
                <test>Try to create duplicate financial center</test>
                <test>Test validation errors display</test>
                <test>Test network error handling</test>
            </tests>
        </step>

        <step number="5">
            <action>Apply similar fixes to other settings pages</action>
            <files>
                <file>settings/periods/+page.svelte</file>
                <file>settings/cost-centers/+page.svelte</file>
                <file>settings/nomenclatures/+page.svelte</file>
            </files>
            <description>Check for similar data contract mismatches and error handling issues</description>
        </step>
    </solution>

    <verification>
        <unit_tests>backend-fastapi/tests/backend/test_financial_centers_api.py</unit_tests>
        <integration_tests>frontend-svelte/tests/frontend/financial_centers.test.ts</integration_tests>
        <manual_testing>
            <test>Create, update, delete financial centers</test>
            <test>Verify error messages are readable</test>
            <test>Check data persistence</test>
        </manual_testing>
    </verification>
</plan>