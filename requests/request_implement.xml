        <change>Filter reference-data category: category.id !== 'reference-data' || $isAdmin</change>
      </settings_navigation>

      <reference_pages>
        <admin_check>
          <code>
            {#if $isAdmin}
              <!-- Full CRUD interface -->
              <button on:click={createItem}>Create New</button>
              <button on:click={editItem}>Edit</button>
              <button on:click={deleteItem}>Delete</button>
            {:else}
              <!-- Read-only view -->
              <div class="text-center py-8">
                <p class="text-gray-500">Reference data management requires administrator privileges.</p>
                <p class="text-sm text-gray-400">Contact your administrator to make changes.</p>
              </div>
            {/if}
          </code>
        </admin_check>
      </reference_pages>
    </frontend_modifications>
  </technical_specifications>

  <migration_strategy>
    <pre_migration>
      <step>1. Backup current database completely</step>
      <step>2. Run data analysis script to identify duplicate records</step>
      <step>3. Create consolidation plan report</step>
      <step>4. Verify foreign key relationships</step>
    </pre_migration>

    <migration_execution>
      <step>1. Put application in maintenance mode</step>
      <step>2. Run consolidation script to merge duplicate data</step>
      <step>3. Execute database migration (schema changes)</step>
      <step>4. Deploy backend API changes</step>
      <step>5. Deploy frontend changes</step>
      <step>6. Run post-migration validation</step>
      <step>7. Exit maintenance mode</step>
    </migration_execution>

    <post_migration>
      <step>1. Verify all users can see shared reference data</step>
      <step>2. Verify only admins can modify reference data</step>
      <step>3. Test existing transactions still work with new references</step>
      <step>4. Monitor for any foreign key violations</step>
    </post_migration>

    <rollback_plan>
      <condition>If migration fails or causes issues</condition>
      <steps>
        <step>1. Restore database from backup</step>
        <step>2. Revert backend API deployment</step>
        <step>3. Revert frontend deployment</step>
        <step>4. Investigate root cause</step>
      </steps>
    </rollback_plan>
  </migration_strategy>

