  <technical_specifications>

    <database_changes>
      <migration_script>
        <name>xxx_migrate_to_shared_references.py</name>
        <operations>
          <operation type="modify_constraint">
            <table>t_d_period</table>
            <action>DROP CONSTRAINT _period_dt_user_uc</action>
          </operation>
          <operation type="modify_constraint">
            <table>t_d_period</table>
            <action>ADD CONSTRAINT _period_dt_unique UNIQUE (period_dt)</action>
          </operation>
          <operation type="add_column">
            <table>t_d_period</table>
            <column>created_by INTEGER REFERENCES t_d_user(user_id)</column>
          </operation>
          <operation type="add_column">
            <table>t_d_period</table>
            <column>managed_by INTEGER REFERENCES t_d_user(user_id)</column>
          </operation>
          <operation type="modify_column">
            <table>t_d_period</table>
            <column>user_id SET NULL</column>
          </operation>
          <!-- Similar operations for financial_center, cost_center, nomenclature tables -->
        </operations>
      </migration_script>

      <consolidation_script>
        <name>consolidate_reference_data.py</name>
        <logic>
          <step>FOR EACH reference table (periods, financial_centers, cost_centers, nomenclatures)</step>
          <step>  GROUP records BY name</step>
          <step>  FOR EACH group with multiple records</step>
          <step>    SELECT oldest record as master (MIN created_at)</step>
          <step>    UPDATE registry table foreign keys to point to master</step>
          <step>    SET master.created_by = master.user_id</step>
          <step>    SET master.user_id = NULL</step>
          <step>    DELETE duplicate records</step>
          <step>  END FOR</step>
          <step>END FOR</step>
        </logic>
      </consolidation_script>
    </database_changes>

    <api_endpoint_changes>
      <security_model>
        <read_operations>
          <access_level>All authenticated users</access_level>
          <filtering>No user_id filtering - global data</filtering>
        </read_operations>
        <write_operations>
          <access_level>Admin users only</access_level>
          <dependency>require_admin_access from app.core.security</dependency>
        </write_operations>
      </security_model>

      <endpoint_modifications>
        <endpoint path="GET /api/periods/" change="remove_user_filtering">
          <before>WHERE Period.user_id == current_user.get('user_id')</before>
          <after>No user_id filtering - return all periods</after>
        </endpoint>
        <endpoint path="POST /api/periods/" change="add_admin_check">
          <before>current_user: dict = Depends(get_current_user)</before>
          <after>current_user: dict = Depends(require_admin_access)</after>
        </endpoint>
        <!-- Similar changes for financial_centers, cost_centers, nomenclatures -->
      </endpoint_modifications>
    </api_endpoint_changes>

