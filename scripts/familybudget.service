[Unit]
Description=Family Budget Application (Docker Compose)
Documentation=https://github.com/ikeniborn/familyBudget
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/budget

# NOTE: PostgreSQL repair removed - Docker managed volume handles this automatically

# Start all containers
ExecStart=/usr/bin/docker compose up -d

# Stop all containers gracefully
ExecStop=/usr/bin/docker compose down

# Restart policy
Restart=on-failure
RestartSec=10

# Timeouts
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
