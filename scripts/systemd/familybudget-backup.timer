[Unit]
Description=Family Budget Daily Backup Timer
Documentation=file:///path/to/project/scripts/README.md
Requires=familybudget-backup.service

[Timer]
# Run daily at 2:00 AM
OnCalendar=daily
OnCalendar=*-*-* 02:00:00

# If system was off, run 10 minutes after boot
OnBootSec=10min

# Persistent - run missed timers after reboot
Persistent=true

# Accuracy (allow up to 15min delay for system load)
AccuracySec=15min

# Randomize start time by up to 5 minutes (spread load)
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
