{
  "services": {
    "postgres": {
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 5432,
          "published": "5432",
          "protocol": "tcp"
        }
      ]
    },
    "redis": {
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 6379,
          "published": "6379",
          "protocol": "tcp"
        }
      ]
    },
    "backend": {
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 8000,
          "published": "8000",
          "protocol": "tcp"
        }
      ]
    }
  }
}
