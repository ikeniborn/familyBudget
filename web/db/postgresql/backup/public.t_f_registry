-- public.t_f_registry definition

-- Drop table

-- DROP TABLE public.t_f_registry;

CREATE TABLE public.t_f_registry (
	registry_key uuid NOT NULL,
	operation_dttm timestamp NOT NULL,
	period_key uuid NOT NULL,
	financial_center_key uuid NOT NULL,
	cost_center_key uuid NOT NULL,
	nomenclature_key uuid NOT NULL,
	cost_sum numeric(12, 2) NOT NULL,
	comment_description varchar NOT NULL,
	row_type_key uuid NOT NULL,
	user_key uuid NOT NULL,
	created_dttm timestamp DEFAULT now() NOT NULL,
	updated_dttm timestamp DEFAULT now() NOT NULL,
	CONSTRAINT t_f_registry_pkey PRIMARY KEY (registry_key, operation_dttm)
)
PARTITION BY RANGE (operation_dttm);
CREATE INDEX idx_t_f_registry_operation_dttm ON ONLY public.t_f_registry USING btree (operation_dttm);


-- public.t_f_registry foreign keys

ALTER TABLE public.t_f_registry ADD CONSTRAINT t_f_registry_cost_center_key_fkey FOREIGN KEY (cost_center_key) REFERENCES public.t_d_cost_center(cost_center_key);
ALTER TABLE public.t_f_registry ADD CONSTRAINT t_f_registry_financial_center_key_fkey FOREIGN KEY (financial_center_key) REFERENCES public.t_d_financial_center(financial_center_key);
ALTER TABLE public.t_f_registry ADD CONSTRAINT t_f_registry_nomenclature_key_fkey FOREIGN KEY (nomenclature_key) REFERENCES public.t_d_nomenclature(nomenclature_key);
ALTER TABLE public.t_f_registry ADD CONSTRAINT t_f_registry_period_key_fkey FOREIGN KEY (period_key) REFERENCES public.t_d_period(period_key);
ALTER TABLE public.t_f_registry ADD CONSTRAINT t_f_registry_row_type_key_fkey FOREIGN KEY (row_type_key) REFERENCES public.t_d_row_type(row_type_key);
ALTER TABLE public.t_f_registry ADD CONSTRAINT t_f_registry_user_key_fkey FOREIGN KEY (user_key) REFERENCES public.t_d_user(user_key);